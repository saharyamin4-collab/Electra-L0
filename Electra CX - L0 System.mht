    const dup=reports.find(r=>norm(r.site)===norm(h.site)&&norm(quad(r))===norm(h.quadrant)&&norm(r.module)===norm(h.module));
    if(dup){ const key=h.site+'|'+h.quadrant+'|'+h.module; if(ensureCreated.asked===key){ setSync('bad','מודול זה כבר קיים. שנה את מספר המודול.'); return false; } ensureCreated.asked=key;
      if(confirm('כבר קיים צ׳קליסט למודול '+h.module+' באתר '+h.site+', רביע '+h.quadrant+'. לפתוח אותו?')){ openReport(dup.id); } else { setSync('bad','מודול זה כבר קיים. שנה את מספר המודול.'); } return false; }
    creating=(async()=>{
      SECS.forEach(k=>Object.assign(cur[k],readSec(k)));
      const ref=col.doc(); const body=clone(cur); delete body.id; body.createdBy=me; Object.assign(body.log,logEntry('הצ׳קליסט נפתח'));
      for(let i=0;i<4;i++){ try{ await ref.set(body); cur.id=ref.id; cur.log=body.log; ['hdr',...SECS].forEach(k=>dirty[k]=false); dropDraft(null); setSync('ok','נשמר'); setHash(cur.id); toast('נפתח צ׳קליסט למודול '+cur.module); paint(false); return true; }catch(_){ await sleep(1000*2**i); } }
      toast('פתיחת הצ׳קליסט נכשלה. בדוק חיבור.'); return false;
    })();
