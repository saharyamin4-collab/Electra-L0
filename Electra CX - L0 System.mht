    SECS.forEach(k=>{ if(k==='s4'&&!(r.s4&&r.s4.sig)) return; o[k]={}; TEXT[k].forEach(x=>{ if(r[k][x]!==undefined) o[k][x]=r[k][x]; }); o[k].sig=sg(r[k]); });
