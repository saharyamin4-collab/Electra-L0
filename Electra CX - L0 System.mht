  if(S.draft)h+=healthHTML(S.draft)+gridHTML(S.draft,true)+`<details class="card fold" style="margin-top:14px"><summary><span class="ibadge" aria-hidden="true">${ico('sparkle')}</span><span>סטטיסטיקה של העדפות</span>${ico('chev','chev')}</summary><div class="fold-b">${statsHTML(S.draft)}</div></details>`;
