  function canon(r,shas){
    const f=(m,withCell)=>live(m).map(p=>({assetId:p.assetId||'',name:p.name||'',size:p.size||0,sha:(shas&&shas[p.assetId])||'',...(withCell&&p.cell?{cell:p.cell}:{})}));
