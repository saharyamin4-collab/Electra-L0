function deadlineChip(){const s=S.settings;if(!s.deadline)return'';const d=parseYmd(s.deadline),end=new Date(d);end.setHours(23,59,59,999);const ms=end-Date.now(),days=Math.ceil(ms/864e5);
  const lbl=`${DAYN[d.getDay()]} ${dm(d)}`;
  if(ms<0)return`<span class="hchip bad">${ico('clock')}ההגשה הסתיימה (${lbl})</span>`;
  if(days<=1)return`<span class="hchip warn">${ico('clock')}ההגשה נסגרת היום</span>`;
  return`<span class="hchip">${ico('clock')}הגשה עד ${lbl} · נותרו ${days} ימים</span>`}
function heroHTML(){
  const s=S.settings,chips=[deadlineChip()];
  if(S.tab==='prefs'){const p=S.me,miss=missingDays(p).length;
    if(complete(p)&&S.savedAt)chips.push(`<span class="hchip ok">${ico('check')}ההעדפות שלך שמורות</span>`);
    else if((p.roles||[]).length&&!miss)chips.push(`<span class="hchip">${ico('check')}הכל מולא, אפשר לשמור</span>`);
    else chips.push(`<span class="hchip warn">${ico('alert')}${(p.roles||[]).length?'נשארו '+miss+' ימים למלא':'בחר תפקיד'}</span>`)}
  else if(S.tab==='sched'){const ok=S.schedule&&S.schedule.days;chips.push(ok?`<span class="hchip ok">${ico('check')}הסידור פורסם</span>`:`<span class="hchip">${ico('clock')}ממתין לפרסום</span>`)}
  else if(S.unlocked){const n=Object.keys(teamAll()).length;chips.push(`<span class="hchip">${ico('users')}${n} הגישו העדפות</span>`)}
  return`<section class="hero"><div class="deco" aria-hidden="true"><i></i><i></i><i></i></div><div class="eyebrow">סידור משמרות קומישנינג · בית שמש</div><h1 class="num">שבוע ${esc(rangeLabel(s))}</h1><div class="hchips">${chips.filter(Boolean).join('')}</div></section>`}
function statusBanner(){
  if(window.__cxShim&&S.mode==='local')return`<div class="banner warn"><span>⚠️</span><span><b>אין חיבור לשרת.</b> ${esc(S.connErr||'ספריית Firebase לא נטענה')}. ההעדפות נשמרות רק במכשיר הזה ולא יגיעו למנהל.<br><b>מה לעשות:</b> פתח את הקובץ ב-Chrome (מתוך ההורדות), ולא מתוך וואטסאפ, תצוגה מקדימה או מסך "תוכן אינטרנטי". <button class="link" data-action="retry">נסה שוב</button></span></div>`;
  if(S.saveErr)return`<div class="banner warn"><span>⚠️</span><span><b>לא נשמר בשרת.</b> ${esc(S.saveErrMsg||'')}</span></div>`;
  return''}
function renderMain(){
