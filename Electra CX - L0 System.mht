let fdb=null, online=false, cloudErr='';
const dirtyDocs=new Set(), dirtyAssets=new Set(), synced=new Set(), ver=new Map(), failedAssets=new Set(), inflight=new Set();

function openDb(){ return new Promise((res,rej)=>{ const r=indexedDB.open(DB_NAME,1);
  r.onupgradeneeded=()=>{ const d=r.result; d.createObjectStore('docs',{keyPath:'path'}); d.createObjectStore('assets',{keyPath:'id'}); };
  r.onsuccess=()=>res(r.result); r.onerror=()=>rej(r.error); }); }
const put=(store,val)=>new Promise((res,rej)=>{ if(!idb) return res(); const t=idb.transaction(store,'readwrite'); t.objectStore(store).put(val); t.oncomplete=()=>res(); t.onerror=t.onabort=()=>rej(t.error); });
const del=(store,key)=>new Promise((res,rej)=>{ if(!idb) return res(); const t=idb.transaction(store,'readwrite'); t.objectStore(store).delete(key); t.oncomplete=()=>res(); t.onerror=t.onabort=()=>rej(t.error); });
const getAll=store=>new Promise((res,rej)=>{ const r=idb.transaction(store,'readonly').objectStore(store).getAll(); r.onsuccess=()=>res(r.result); r.onerror=()=>rej(r.error); });

const ready=(async()=>{
  try{
    idb=await openDb();
    for(const d of await getAll('docs')){ docs.set(d.path,d.data); if(d.dirty) dirtyDocs.add(d.path); else synced.add(d.path); }
    for(const a of await getAll('assets')){ assetMeta.set(a.id,a); urls.set(a.id,URL.createObjectURL(a.blob)); if(a.dirty) dirtyAssets.add(a.id); }
  }catch(e){ idb=null; persistent=false; console.warn('IndexedDB unavailable, data will not persist',e); }
  try{ if(navigator.storage&&navigator.storage.persist) await navigator.storage.persist(); }catch(_){}
})();

const segs=p=>p.split('/').filter(Boolean);
const parentOf=p=>segs(p).slice(0,-1).join('/');
const hex=n=>{ const a=new Uint8Array(n); crypto.getRandomValues(a); return [...a].map(b=>b.toString(16).padStart(2,'0')).join('').slice(0,n*2); };
const isObj=v=>v&&typeof v==='object'&&!Array.isArray(v);
function merge(t,p){ for(const k of Object.keys(p)){ const v=p[k]; if(v===undefined) continue; if(isObj(v)&&isObj(t[k])) merge(t[k],v); else t[k]=clone(v); } return t; }

/* RTDB drops empty maps and nulls, so restore the shape the app expects */
function normalize(path,d){ if(!/^reports\/[^/]+$/.test(path)||!isObj(d)) return d;
  d.log=d.log||{}; for(const k of ['s1','s2','s3','s4']){ d[k]=isObj(d[k])?d[k]:{}; if(d[k].sig===undefined) d[k].sig=null; }
  d.s2.photos=d.s2.photos||{}; d.s2.cells=d.s2.cells||{}; d.s2.scans=d.s2.scans||{}; d.s3.files=d.s3.files||{}; d.s4.photos=d.s4.photos||{}; return d; }
const FIXLAB={}; for(let u=1;u<=2;u++){ for(let c=1;c<=7;c++) FIXLAB['u'+u+'c'+c]='UPS'+u+'_תא'+c; FIXLAB['u'+u+'body']='UPS'+u+'_גוף'; FIXLAB['u'+u+'ceil']='UPS'+u+'_תקרה'; }
const keyOf=p=>p.split('/').join('~'), pathOf=k=>k.split('~').join('/');
const stable=o=>{ if(Array.isArray(o)) return '['+o.map(stable).join(',')+']'; if(isObj(o)) return '{'+Object.keys(o).sort().map(k=>JSON.stringify(k)+':'+stable(o[k])).join(',')+'}'; return JSON.stringify(o===undefined?null:o); };
function strip(o){ if(Array.isArray(o)) return o.map(strip); if(isObj(o)){ const r={}; for(const k of Object.keys(o)){ const v=strip(o[k]); if(v===null||v===undefined) continue; if(isObj(v)&&!Object.keys(v).length) continue; r[k]=v; } return r; } return o; }
const same=(path,a,b)=>stable(strip(normalize(path,clone(a))))===stable(strip(normalize(path,clone(b))));
function flatten(o,pre,out){ out=out||{}; pre=pre||''; for(const k of Object.keys(o)){ const v=o[k]; if(v===undefined) continue; if(isObj(v)){ if(Object.keys(v).length) flatten(v,pre+k+'/',out); } else out[pre+k]=v; } return out; }

/* ---- Firestore-style document store ---- */
const listeners=new Set();
function colSnap(cpath){ const n=segs(cpath).length+1, out=[];
  for(const [p,d] of docs){ if(p.startsWith(cpath+'/')&&segs(p).length===n) out.push({id:segs(p).pop(),exists:true,data:()=>normalize(p,clone(d))}); }
  out.sort((a,b)=>a.id<b.id?-1:1);
  return {docs:out,size:out.length,empty:!out.length,metadata:{fromCache:false,hasPendingWrites:false},forEach:f=>out.forEach(f)}; }
function docSnap(p){ const d=docs.get(p); return {id:segs(p).pop(),exists:d!==undefined,data:()=>d===undefined?undefined:normalize(p,clone(d)),metadata:{fromCache:false}}; }
function schedule(l){ if(l.pending) return; l.pending=true; setTimeout(()=>{ l.pending=false; if(!listeners.has(l)) return;
  try{ l.cb(l.kind==='doc'?docSnap(l.path):colSnap(l.path)); }catch(e){ console.error(e); } },0); }
function notifyAll(){ for(const l of listeners) if(l.kind==='col') schedule(l); }
function notify(path){ for(const l of listeners){ if((l.kind==='doc'&&l.path===path)||(l.kind==='col'&&parentOf(path)===l.path)) schedule(l); } }
function listen(kind,path,cb){ const l={kind,path,cb}; listeners.add(l); schedule(l); return ()=>listeners.delete(l); }
async function commit(path,val,patch){
  docs.set(path,val); ver.set(path,(ver.get(path)||0)+1); dirtyDocs.add(path);
  await put('docs',{path,data:val,dirty:true}); notify(path); pushDoc(path,patch); }
function docRef(path){ return {
  id:segs(path).pop(), path,
  get:async()=>{ await ready; return docSnap(path); },
  set:async data=>{ await ready; await commit(path,clone(data),null); },
  update:async patch=>{ await ready; const cur=docs.get(path); if(cur===undefined){ const e=new Error('not-found'); e.code='not-found'; throw e; } const p=clone(patch); await commit(path,merge(clone(cur),p),p); },
  delete:async()=>{ await ready; docs.delete(path); dirtyDocs.delete(path); synced.delete(path); await del('docs',path); notify(path); if(fdb&&online) fdb.ref(CLOUD.ns+'/docs/'+keyOf(path)).remove().catch(()=>{}); },
  onSnapshot:cb=>listen('doc',path,cb),
  collection:n=>colRef(path+'/'+n) }; }
function colRef(path){ return { path, doc:id=>docRef(path+'/'+(id||hex(10))), get:async()=>{ await ready; return colSnap(path); }, onSnapshot:cb=>listen('col',path,cb) }; }
const dbApi={ collection:n=>colRef(n), doc:p=>docRef(p) };

/* ---- file / image store ---- */
window.__assetURL=id=>{ if(urls.has(id)) return urls.get(id); if(fdb) fetchAsset(id); return 'blob:missing-asset'; };
async function blobToDataURL(b){ const u8=new Uint8Array(await b.arrayBuffer()); let s=''; for(let i=0;i<u8.length;i+=0x8000) s+=String.fromCharCode.apply(null,u8.subarray(i,i+0x8000)); return 'data:'+(b.type||'application/octet-stream')+';base64,'+btoa(s); }
async function shrink(b){ const bmp=await createImageBitmap(b); const sc=Math.min(1,1800/Math.max(bmp.width,bmp.height));
  const c=document.createElement('canvas'); c.width=Math.round(bmp.width*sc); c.height=Math.round(bmp.height*sc); const x=c.getContext('2d'); x.fillStyle='#fff'; x.fillRect(0,0,c.width,c.height); x.drawImage(bmp,0,0,c.width,c.height);
  return new Promise((res,rej)=>c.toBlob(r=>r?res(r):rej(new Error('encode')),'image/jpeg',.85)); }
const MAX_ASSET=6.5*1024*1024; /* RTDB node limit is 10MB and base64 adds ~33% */
const assetsApi={
  async upload(blob,opts){ await ready;
    let type=(opts&&opts.type)||blob.type||'application/octet-stream';
    let b=blob.type===type?blob:new Blob([blob],{type});
    if(/^image\/(jpeg|png|webp)$/.test(type)&&b.size>700*1024){ try{ b=await shrink(b); type='image/jpeg'; }catch(_){} }
    if(b.size>MAX_ASSET) throw {code:'too_large'};
    const rec={id:hex(16),type,size:b.size,at:Date.now(),blob:b,dirty:true};
    await put('assets',rec); assetMeta.set(rec.id,rec); dirtyAssets.add(rec.id); urls.set(rec.id,URL.createObjectURL(b)); pushAsset(rec.id);
    return {id:rec.id,sizeBytes:b.size,contentType:type,url:urls.get(rec.id)}; },
  async list(){ await ready; let bytes=0; assetMeta.forEach(a=>bytes+=a.size);
    let max=2*1024*1024*1024; try{ const e=await navigator.storage.estimate(); if(e&&e.quota) max=e.quota; }catch(_){}
    return {assets:[...assetMeta.values()].map(a=>({id:a.id,type:a.type,sizeBytes:a.size})),usage:{bytes,maxBytes:max}}; }
};

/* ---- cloud sync engine ---- */
function pendingCount(){ return dirtyDocs.size+dirtyAssets.size; }
function updateStatus(){ const el=document.getElementById('cloudStatus'); if(!el) return; let t;
  if(!fdb) t='מצב מקומי בלבד: אין חיבור לשירות הענן. הנתונים שמורים במכשיר הזה.';
  else if(cloudErr) t='שגיאת סנכרון לענן ('+cloudErr+'). השינויים שמורים במכשיר.'+(/PERMISSION/i.test(cloudErr)?' כללי ה־Realtime Database חוסמים את הנתיב '+CLOUD.ns+'.':'');
  else if(!online) t='לא מחובר לענן.'+(pendingCount()?' '+pendingCount()+' פריטים ממתינים.':'')+' השינויים שמורים במכשיר ויסונכרנו בחיבור הבא.';
  else if(pendingCount()) t='מסנכרן '+pendingCount()+' פריטים לענן…';
  else t='מסונכרן לענן ✓';
  el.textContent=t; }
const fail=e=>{ cloudErr=(e&&(e.code||e.message))||'error'; updateStatus(); };
function pushDoc(path,patch){
  if(!fdb||!online){ updateStatus(); return; }
  const v=ver.get(path), ref=fdb.ref(CLOUD.ns+'/docs/'+keyOf(path)); let p;
  if(patch&&synced.has(path)){ const flat=flatten(patch); p=Object.keys(flat).length?ref.update(flat):Promise.resolve(); }
  else p=ref.set(clone(docs.get(path)));
  p.then(()=>{ synced.add(path); cloudErr=''; if(ver.get(path)===v){ dirtyDocs.delete(path); put('docs',{path,data:docs.get(path),dirty:false}).catch(()=>{}); } updateStatus(); },fail);
  updateStatus(); }
async function pushAsset(id){
  if(!fdb||!online) return updateStatus(); const rec=assetMeta.get(id); if(!rec) return;
  try{ await fdb.ref(CLOUD.ns+'/assets/'+id).set({type:rec.type,size:rec.size,at:rec.at,data:await blobToDataURL(rec.blob)});
    rec.dirty=false; dirtyAssets.delete(id); cloudErr=''; await put('assets',rec); updateStatus(); }catch(e){ fail(e); } }
async function fetchAsset(id){
  if(!fdb||!online||inflight.has(id)||failedAssets.has(id)||assetMeta.has(id)) return; inflight.add(id);
  try{ const v=(await fdb.ref(CLOUD.ns+'/assets/'+id).once('value')).val();
    if(!v||!v.data){ failedAssets.add(id); return; }
    const blob=await (await fetch(v.data)).blob(), b=blob.type===v.type?blob:new Blob([blob],{type:v.type});
    if(!assetMeta.has(id)){ const rec={id,type:v.type,size:b.size,at:v.at||Date.now(),blob:b,dirty:false}; await put('assets',rec); assetMeta.set(id,rec); urls.set(id,URL.createObjectURL(b)); notifyAll(); }
  }catch(e){ failedAssets.add(id); } finally{ inflight.delete(id); } }
function assetIdsOf(r){ const ids=[]; Object.values((r.s2&&r.s2.photos)||{}).concat(Object.values((r.s3&&r.s3.files)||{}),Object.values((r.s4&&r.s4.photos)||{})).forEach(p=>p&&p.assetId&&ids.push(p.assetId));
  ['s1','s2','s3','s4'].forEach(k=>{ const g=r[k]&&r[k].sig; if(g&&g.assetId) ids.push(g.assetId); }); return ids; }
function prefetch(path,d){ if(/^reports\/[^/]+$/.test(path)) assetIdsOf(d).forEach(id=>{ if(!urls.has(id)) fetchAsset(id); }); }
function flushAll(){ [...dirtyDocs].forEach(p=>pushDoc(p,null)); [...dirtyAssets].forEach(pushAsset); }
function applyRemote(key,val){
  if(val===null||val===undefined) return; const path=pathOf(key), data=normalize(path,val); synced.add(path);
  const local=docs.get(path);
  if(local&&dirtyDocs.has(path)&&!same(path,local,data)){ if((local.updatedAt||0)>=(data.updatedAt||0)){ pushDoc(path,null); return; } dirtyDocs.delete(path); }
  if(local&&same(path,local,data)) return;
  docs.set(path,data); put('docs',{path,data,dirty:false}).catch(()=>{}); notify(path); prefetch(path,data); }
function removeRemote(key){ const path=pathOf(key); if(!docs.has(path)) return; docs.delete(path); dirtyDocs.delete(path); synced.delete(path); del('docs',path).catch(()=>{}); notify(path); }
function initCloud(){
  if(!CLOUD.enabled||!window.firebase) return;
  try{ const app=(firebase.apps||[]).find(a=>a.name==='ups')||firebase.initializeApp(CLOUD.config,'ups'); fdb=app.database(); }catch(e){ fdb=null; return; }
  fdb.ref('.info/connected').on('value',s=>{ online=!!s.val(); if(online){ failedAssets.clear(); flushAll(); for(const [p,d] of docs) prefetch(p,d); } updateStatus(); });
  const dr=fdb.ref(CLOUD.ns+'/docs'), on=s=>{ cloudErr=''; applyRemote(s.key,s.val()); updateStatus(); };
  dr.on('child_added',on,fail); dr.on('child_changed',on,fail); dr.on('child_removed',s=>removeRemote(s.key),fail); }
const userApi={ id:async()=>'local', canEdit:async()=>true };

/* ---- helpers: download, zip, backup/restore ---- */
function triggerDownload(blob,filename){ const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=filename; document.body.appendChild(a); a.click(); setTimeout(()=>{ URL.revokeObjectURL(a.href); a.remove(); },5000); }
const today=()=>new Date().toISOString().slice(0,10);
const safe=s=>String(s==null?'':s).replace(/[\\\/:*?"<>|\s]+/g,'_').replace(/^_+|_+$/g,'');
const quadOf=r=>(r.quadrant!=null&&r.quadrant!=='')?r.quadrant:(r.location||'');
const reportDocs=()=>[...docs.entries()].filter(([p])=>/^reports\/[^/]+$/.test(p)).map(([p,d])=>({...d,id:segs(p)[1]}));
function toast(m){ const t=document.getElementById('toast'); if(!t){ alert(m); return; } t.textContent=m; t.classList.add('on'); clearTimeout(toast.h); toast.h=setTimeout(()=>t.classList.remove('on'),4500); }

async function augmentBackup(json){ let obj; try{ obj=JSON.parse(json); }catch(_){ return json; }
  const assets={}; for(const a of assetMeta.values()) assets[a.id]={type:a.type,size:a.size,at:a.at,data:await blobToDataURL(a.blob)};
  obj.assets=assets; obj.format=3; return JSON.stringify(obj,null,2); }

const downloadsApi={ async save({filename,data}){
  let blob;
  if(typeof data==='string'){
    if(/^cx-electra-checklists-backup-.*\.json$/.test(filename)) data=await augmentBackup(data);
    blob=new Blob([data],{type:/\.csv$/.test(filename)?'text/csv;charset=utf-8':/\.json$/.test(filename)?'application/json':'text/plain'});
  } else blob=data;
  triggerDownload(blob,filename); return {filename}; } };

const crcT=(()=>{ const t=new Uint32Array(256); for(let n=0;n<256;n++){ let c=n; for(let k=0;k<8;k++) c=c&1?0xEDB88320^(c>>>1):c>>>1; t[n]=c>>>0; } return t; })();
function crc32(u8){ let c=0xFFFFFFFF; for(let i=0;i<u8.length;i++) c=crcT[(c^u8[i])&255]^(c>>>8); return (c^0xFFFFFFFF)>>>0; }
function makeZip(files){
  const enc=new TextEncoder(), parts=[], central=[]; let off=0;
  const d=new Date(), dt=(d.getHours()<<11)|(d.getMinutes()<<5)|(d.getSeconds()>>1), dd=((d.getFullYear()-1980)<<9)|((d.getMonth()+1)<<5)|d.getDate();
  for(const f of files){
    const nm=enc.encode(f.name), crc=crc32(f.data), sz=f.data.length;
    const lh=new DataView(new ArrayBuffer(30));
    lh.setUint32(0,0x04034b50,true); lh.setUint16(4,20,true); lh.setUint16(6,0x0800,true); lh.setUint16(8,0,true); lh.setUint16(10,dt,true); lh.setUint16(12,dd,true);
    lh.setUint32(14,crc,true); lh.setUint32(18,sz,true); lh.setUint32(22,sz,true); lh.setUint16(26,nm.length,true); lh.setUint16(28,0,true);
    parts.push(lh.buffer,nm,f.data);
    const ch=new DataView(new ArrayBuffer(46));
    ch.setUint32(0,0x02014b50,true); ch.setUint16(4,20,true); ch.setUint16(6,20,true); ch.setUint16(8,0x0800,true); ch.setUint16(10,0,true); ch.setUint16(12,dt,true); ch.setUint16(14,dd,true);
    ch.setUint32(16,crc,true); ch.setUint32(20,sz,true); ch.setUint32(24,sz,true); ch.setUint16(28,nm.length,true); ch.setUint32(42,off,true);
    central.push(ch.buffer,nm); off+=30+nm.length+sz; }
  let csz=0; central.forEach(x=>csz+=x.byteLength);
  const end=new DataView(new ArrayBuffer(22)); end.setUint32(0,0x06054b50,true); end.setUint16(8,files.length,true); end.setUint16(10,files.length,true); end.setUint32(12,csz,true); end.setUint32(16,off,true);
  return new Blob([...parts,...central,end.buffer],{type:'application/zip'}); }

const EXT={'image/jpeg':'.jpg','image/png':'.png','image/webp':'.webp','image/gif':'.gif','application/pdf':'.pdf'};
function withExt(name,type){ return /\.[A-Za-z0-9]{2,5}$/.test(name)?name:name+(EXT[type]||''); }
async function exportZip(){
  await ready; const files=[], used=new Set(), seen=new Set();
  const add=async(folder,name,id,type)=>{ const a=assetMeta.get(id); if(!a) return; seen.add(id);
    let base=withExt(safe(name)||id,type||a.type), full=folder+'/'+base, i=1;
    while(used.has(full)){ const m=base.match(/^(.*?)(\.[A-Za-z0-9]+)?$/); full=folder+'/'+m[1]+'_'+(++i)+(m[2]||''); }
    used.add(full); files.push({name:full,data:new Uint8Array(await a.blob.arrayBuffer())}); };
  for(const r of reportDocs()){
    const folder=safe([r.site,quadOf(r),r.module].filter(Boolean).join('_'))||r.id;
    const cl=Object.values((r.s2&&r.s2.cells)||{}).filter(c=>c&&!c.removed).sort((x,y)=>((x.t||0)-(y.t||0))||String(x.id).localeCompare(String(y.id)));
    for(const p of Object.values((r.s2&&r.s2.photos)||{})){ const ci=p.cell?cl.findIndex(c=>c.id===p.cell):-1; await add(folder+'/photos',(p.removed?'removed_':'')+(FIXLAB[p.cell]?FIXLAB[p.cell]+'_':ci>=0?'תא'+(ci+1)+'_':'')+(p.name||p.assetId),p.assetId,p.type); }
    for(const p of Object.values((r.s4&&r.s4.photos)||{})) await add(folder+'/fire-stopping',(p.removed?'removed_':'')+(p.name||p.assetId),p.assetId,p.type);
    for(const p of Object.values((r.s3&&r.s3.files)||{})) await add(folder+'/inspector',(p.removed?'removed_':'')+(p.name||p.assetId),p.assetId,p.type);
    for(const k of ['s1','s2','s3','s4']){ const s=r[k]&&r[k].sig; if(!s) continue;
      if(s.assetId) await add(folder+'/signatures','signature-'+k+'.png',s.assetId,'image/png');
      else if(s.data){ const b=await (await fetch(s.data)).blob(); files.push({name:folder+'/signatures/signature-'+k+'.png',data:new Uint8Array(await b.arrayBuffer())}); } } }
  for(const a of assetMeta.values()) if(!seen.has(a.id)) await add('unlinked',a.id,a.id,a.type);
  if(!files.length){ toast('אין עדיין תמונות או קבצים לייצוא'); return; }
  triggerDownload(makeZip(files),'cx-electra-files-'+today()+'.zip'); toast('הורד ZIP עם '+files.length+' קבצים'); }

function missingAssets(){ const miss=new Set();
  for(const r of reportDocs()){
    Object.values((r.s2&&r.s2.photos)||{}).concat(Object.values((r.s3&&r.s3.files)||{}),Object.values((r.s4&&r.s4.photos)||{})).forEach(p=>{ if(p.assetId&&!assetMeta.has(p.assetId)) miss.add(p.assetId); });
    ['s1','s2','s3','s4'].forEach(k=>{ const s=r[k]&&r[k].sig; if(s&&s.assetId&&!assetMeta.has(s.assetId)) miss.add(s.assetId); }); }
  return miss.size; }
async function restoreBackup(obj){ await ready;
  if(!obj||!Array.isArray(obj.reports)) throw new Error('bad-format');
  let nr=0, na=0;
  for(const [id,a] of Object.entries(obj.assets||{})){ const blob=await (await fetch(a.data)).blob(); const b=blob.type===a.type?blob:new Blob([blob],{type:a.type});
    const rec={id,type:a.type,size:b.size,at:a.at||Date.now(),blob:b,dirty:true}; await put('assets',rec); assetMeta.set(id,rec); dirtyAssets.add(id); pushAsset(id); if(urls.has(id)) URL.revokeObjectURL(urls.get(id)); urls.set(id,URL.createObjectURL(b)); na++; }
  for(const r of obj.reports){ if(!r||!r.id) continue; const {id,...rest}=r; await commit('reports/'+id,rest,null); nr++; }
  for(const [rid,d] of Object.entries(obj.sealed||{})){ const r=obj.reports.find(x=>x.id===rid); if(r&&r.seal&&r.seal.path) await commit(r.seal.path,d,null); }
  for(const [rid,vs] of Object.entries(obj.versions||{})) for(const [vid,d] of Object.entries(vs)) await commit('reports/'+rid+'/versions/'+vid,d,null);
  return {reports:nr,assets:na,missing:missingAssets()}; }

function wire(){
  const foot=document.querySelector('.foot'); if(!foot) return;
  const mk=(id,txt)=>{ const b=document.createElement('button'); b.className='btn small'; b.id=id; b.type='button'; b.textContent=txt; return b; };
  const anchor=document.getElementById('storage');
  const zipBtn=mk('zipBtn','ייצוא כל התמונות והקבצים (ZIP)'), resBtn=mk('restoreBtn','שחזור מגיבוי'), inp=document.createElement('input');
