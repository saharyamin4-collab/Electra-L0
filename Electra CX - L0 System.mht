    h+=`<div class="sec-h"><h2>השבוע שלי</h2><small>${sc.publishedAt?'פורסם '+esc(new Date(sc.publishedAt).toLocaleDateString('he-IL',{weekday:'long',day:'numeric',month:'numeric'})):''}</small></div><div class="mine">${keys.map(k=>{const d=parseYmd(k);const sh=SH.find(x=>(sc.days[k][x]||[]).includes(me));const rl=sh?myRole(sc,k,me):null;
