function buildSchedule(s,team){
  const ids=Object.keys(team).filter(id=>team[id]&&team[id].name);
  const debt={},offc={},last={};ids.forEach(i=>{debt[i]=0;offc[i]=0});
  const res={period:s.start,days:{},ranks:{},roles:{},people:{},hrs:{hours:clone(s.hours),fri:s.fri.hours.slice()}};
  ids.forEach(i=>res.people[i]=team[i].name.trim());
  for(const day of periodDays(s)){
    const avail=ids.filter(i=>!isOff(team[i],day.w));
    const slots=[];dayShifts(day.w).forEach(sh=>slotRoles(s,day.w,sh).forEach(role=>slots.push({sh,role})));
    const cols=[...slots,...Array(Math.max(0,avail.length-slots.length)).fill(null)];
    const out={morning:[],afternoon:[],evening:[]},rk={};
    if(avail.length){
      const cost=avail.map(id=>cols.map(sl=>{
        const jit=(hash(id+day.key+(sl?sl.sh+sl.role:'x'))%97)/1000;
        if(sl===null)return 10+4*offc[id]+jit;
        const r=rankOf(team[id],day.w,sl.sh);
        let c=[0,3,8][r]*(1+.5*debt[id]);
        const l=last[id];if(l!=null&&(spanOf(s,day.key,day.w,sl.sh).a-l)/60<s.rest)c+=600;
        if(!canDo(team[id],sl.role))c+=1e5;
        return c+jit}));
      const asg=hungarian(cost);
      avail.forEach((id,i)=>{const sl=cols[asg[i]];
        if(sl&&canDo(team[id],sl.role)){out[sl.sh].push(id);const r=rankOf(team[id],day.w,sl.sh);rk[id]=r;debt[id]+=[0,1,2.5][r];last[id]=spanOf(s,day.key,day.w,sl.sh).b}
        else offc[id]++});
    }
    res.days[day.key]=out;res.ranks[day.key]=rk;
  }
  recomputeRoles(res,s,team);
  return res}
function schedStats(sc){const c=[0,0,0];Object.values(sc.ranks||{}).forEach(rk=>Object.values(rk).forEach(r=>c[r]++));const t=c[0]+c[1]+c[2];return{c,t}}
function shortages(s,sc){let n=0;periodDays(s).forEach(d=>{const o=sc.days[d.key];if(!o)return;const rl=(sc.roles||{})[d.key];dayShifts(d.w).forEach(sh=>{const ids=o[sh]||[];if(rl){n+=Object.values(missingRoles(s,d.w,sh,rl,ids)).reduce((x,y)=>x+y,0)}else n+=Math.max(0,capOf(s,d.w,sh)-ids.length)})});return n}

