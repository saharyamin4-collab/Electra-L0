<!doctype html>
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>CX-ELECTRA / צ׳קליסט מוכנות לבדיקות בעומס למערכות אל־פסק</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F4F6FA; --surface:#FFFFFF; --sunk:#F1F4F9; --ink:#0A0F1C; --ink-2:#5B6478; --ink-3:#8A93A6; --line:#E3E8F0; --line-2:#EDF1F6;
  --brand:#2D5BFF; --brand-2:#1F44D6; --brand-soft:#EAF0FF; --cyan:#12C2E9;
  --ok:#0FA968; --ok-soft:#E3F7EE; --warn:#C27A00; --warn-soft:#FFF4DE; --bad:#E0412F; --bad-soft:#FDECEA;
  --dark:#0A0F1C; --dark-2:#121A2E;
  --shadow-s:0 1px 2px rgba(10,15,28,.05); --shadow:0 1px 2px rgba(10,15,28,.04),0 8px 24px -8px rgba(10,15,28,.10);
  color-scheme:light;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#090D17; --surface:#111726; --sunk:#0D1320; --ink:#EEF1F7; --ink-2:#A2ABBE; --ink-3:#6E7890; --line:#222B3E; --line-2:#1A2233;
    --brand:#5B80FF; --brand-2:#7C9AFF; --brand-soft:#16204A; --cyan:#3AD3F2;
    --ok:#34D399; --ok-soft:#0F2A20; --warn:#F2B347; --warn-soft:#2B210E; --bad:#F87563; --bad-soft:#331816;
    --shadow-s:0 1px 2px rgba(0,0,0,.3); --shadow:0 1px 2px rgba(0,0,0,.3),0 12px 32px -12px rgba(0,0,0,.6); color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#090D17; --surface:#111726; --sunk:#0D1320; --ink:#EEF1F7; --ink-2:#A2ABBE; --ink-3:#6E7890; --line:#222B3E; --line-2:#1A2233;
  --brand:#5B80FF; --brand-2:#7C9AFF; --brand-soft:#16204A; --cyan:#3AD3F2;
  --ok:#34D399; --ok-soft:#0F2A20; --warn:#F2B347; --warn-soft:#2B210E; --bad:#F87563; --bad-soft:#331816;
  --shadow-s:0 1px 2px rgba(0,0,0,.3); --shadow:0 1px 2px rgba(0,0,0,.3),0 12px 32px -12px rgba(0,0,0,.6); color-scheme:dark;
}
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 72px)}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Rubik","Heebo","Segoe UI",Arial,sans-serif;font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:color-mix(in srgb,var(--surface) 80%,transparent);backdrop-filter:blur(14px)}
img{max-width:100%}
button,input,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--brand);outline-offset:2px}
[hidden]{display:none!important}

/* ---------- Top bar ---------- */
.topbar{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:color-mix(in srgb,var(--surface) 80%,transparent);backdrop-filter:blur(14px) saturate(1.4);-webkit-backdrop-filter:blur(14px) saturate(1.4);border-bottom:1px solid var(--line)}
.topbar-in{max-width:1080px;margin:0 auto;padding:12px 24px;display:flex;align-items:center;gap:16px}
.logo-slot{display:flex;align-items:center}
.logo-slot img{max-height:34px;max-width:200px;object-fit:contain;display:block}
.wordmark{font-family:"Rubik",sans-serif;direction:ltr;white-space:nowrap;display:inline-flex;align-items:center;gap:11px;color:var(--ink)}
.wm-ico{width:34px;height:34px;border-radius:11px;flex:none;position:relative;overflow:hidden;display:grid;place-items:center;
  background:linear-gradient(140deg,var(--brand) 0%,#4C78FF 48%,var(--cyan) 100%);
  box-shadow:0 8px 18px -8px color-mix(in srgb,var(--brand) 80%,transparent),inset 0 1px 0 rgba(255,255,255,.4),inset 0 -1px 0 rgba(0,0,0,.12)}
.wm-ico::before{content:"";position:absolute;inset:0;background:radial-gradient(70% 55% at 28% 18%,rgba(255,255,255,.5),transparent 70%)}
.wm-ico::after{content:"";position:absolute;inset:-40% auto -40% -60%;width:40%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.55),transparent);transform:skewX(-20deg);animation:wmShine 5.5s ease-in-out 1.2s infinite}
@keyframes wmShine{0%,78%{left:-60%}100%{left:130%}}
.wm-ico svg{width:19px;height:19px;fill:#fff;position:relative;z-index:1;filter:drop-shadow(0 1px 1.5px rgba(8,20,60,.35))}
.wm-txt{display:flex;flex-direction:column;line-height:1}
.wm-main{display:flex;align-items:center;gap:8px}
.wm-cx{font-weight:800;font-size:1.32rem;letter-spacing:-.02em;background:linear-gradient(95deg,var(--brand),var(--cyan));-webkit-background-clip:text;background-clip:text;color:transparent}
.wm-bar{width:2.5px;height:17px;border-radius:2px;background:linear-gradient(var(--cyan),var(--brand));transform:skewX(-16deg)}
.wm-el{font-weight:700;font-size:1.06rem;letter-spacing:.2em;margin-inline-end:-.2em}
.wm-sub{font-size:.55rem;letter-spacing:.3em;color:var(--ink-3);font-weight:500;margin-top:5px;text-transform:uppercase}
@media (max-width:480px){.wm-sub{display:none}.wm-ico{width:30px;height:30px;border-radius:10px}.wm-cx{font-size:1.15rem}.wm-el{font-size:.92rem;letter-spacing:.14em}}
.topbar .sep{width:1px;height:22px;background:var(--line)}
.topbar .prod{color:var(--ink-2);font-size:.92rem}
.topbar .grow{flex:1}
.ghost{background:transparent;border:1px solid var(--line);border-radius:10px;padding:7px 14px;font-size:.86rem;cursor:pointer;color:var(--ink-2);font-weight:500}
.ghost:hover{border-color:var(--brand);color:var(--brand)}

/* ---------- Hero ---------- */
.hero{max-width:1080px;margin:0 auto;padding:44px 24px 28px;display:grid;grid-template-columns:1.4fr 1fr;gap:32px;align-items:end}
.hero h1{font-weight:800;font-size:clamp(2.2rem,5.2vw,3.7rem);line-height:1.04;letter-spacing:-.025em;margin:0}
.hero h1 em{font-style:normal;background:linear-gradient(90deg,var(--brand),var(--cyan));-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{color:var(--ink-2);margin:14px 0 0;font-size:1.05rem;max-width:44ch}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.stat{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:16px;box-shadow:var(--shadow-s)}
.stat .v{font-size:2.1rem;font-weight:700;line-height:1;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.stat .k{font-size:.8rem;color:var(--ink-2);margin-top:8px}
.stat.go{background:linear-gradient(135deg,var(--brand),var(--brand-2));border-color:transparent;color:#fff}
.stat.go .k{color:rgba(255,255,255,.8)}

.wrap{max-width:1080px;margin:0 auto;padding:0 24px 90px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow);overflow:hidden}

/* ---------- Checklist head ---------- */
.cl-head{padding:28px 32px 22px;display:grid;grid-template-columns:1fr auto;gap:20px;align-items:center}
.cl-title .mlabel{font-size:.82rem;color:var(--ink-3);font-weight:500;display:block;margin-bottom:4px}
.cl-title .mnum{font-weight:800;font-size:clamp(2rem,4.4vw,3rem);line-height:1.05;letter-spacing:-.02em;display:block;word-break:break-word}
.cl-title .msub{color:var(--ink-2);font-size:.98rem;display:block;margin-top:8px}
.ring{--p:0;width:84px;height:84px;border-radius:50%;background:conic-gradient(var(--brand) calc(var(--p)*1%),var(--line-2) 0);display:grid;place-items:center;transition:background .5s}
.ring.go{background:conic-gradient(var(--ok) 100%,var(--line-2) 0)}
.ring span{width:68px;height:68px;border-radius:50%;background:var(--surface);display:grid;place-items:center;font-weight:700;font-size:1.25rem;font-variant-numeric:tabular-nums}
.statusline{grid-column:1/-1;display:flex;align-items:center;gap:10px;font-weight:500;padding:11px 14px;border-radius:12px;background:var(--warn-soft);color:var(--warn);font-size:.95rem}
.statusline.go{background:var(--ok-soft);color:var(--ok)}
.statusline .lamp{width:8px;height:8px;border-radius:50%;background:currentColor;box-shadow:0 0 0 4px color-mix(in srgb,currentColor 18%,transparent)}
.toolbar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:12px 32px;border-top:1px solid var(--line-2);background:var(--sunk)}
.toolbar .grow{flex:1}
.btn{border:1px solid var(--line);background:var(--surface);border-radius:12px;padding:10px 18px;cursor:pointer;font-weight:500;font-size:.95rem;transition:all .15s;color:var(--ink)}
.btn:hover{border-color:var(--ink-3)}
.btn.primary{background:var(--brand);color:#fff;border-color:var(--brand);box-shadow:0 6px 16px -8px var(--brand)}
.btn.primary:hover{background:var(--brand-2);border-color:var(--brand-2)}
.btn.brass{background:var(--ink);color:var(--surface);border-color:var(--ink)}
.btn.brass:hover{opacity:.9}
.btn.small{padding:5px 12px;font-size:.84rem;border-radius:9px}
.btn:disabled{opacity:.4;cursor:not-allowed;box-shadow:none}
.sync{font-size:.84rem;display:flex;align-items:center;gap:7px;color:var(--ink-2);background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:4px 12px}
.sync .dot{width:7px;height:7px;border-radius:50%;background:var(--warn)}
.sync.ok .dot{background:var(--ok)} .sync.bad .dot{background:var(--bad)}

.sec{padding:28px 32px;border-top:1px solid var(--line-2)}
#sealBox:not(:empty)+.sec{margin-top:20px}
.banners+#sealBox:empty+.sec{margin-top:14px}
.sec-h{display:flex;align-items:center;gap:14px;margin-bottom:18px;flex-wrap:wrap}
.sec-h h2{font-weight:700;font-size:1.25rem;margin:0;letter-spacing:-.01em}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px 16px}
label.f{display:flex;flex-direction:column;gap:6px;font-size:.84rem;color:var(--ink-2);font-weight:500}
label.f input,label.f textarea{border:1px solid var(--line);background:var(--sunk);border-radius:12px;padding:11px 13px;font-size:1rem;color:var(--ink);transition:border-color .15s,box-shadow .15s,background .15s}
label.f input:hover,label.f textarea:hover{border-color:var(--ink-3)}
label.f input:focus,label.f textarea:focus{outline:none;background:var(--surface);border-color:var(--brand);box-shadow:0 0 0 4px color-mix(in srgb,var(--brand) 16%,transparent)}
label.f input:disabled,label.f textarea:disabled{background:transparent;border-color:var(--line-2);color:var(--ink)}
label.f textarea{min-height:68px;resize:vertical}
.req::after{content:" *";color:var(--brand)}
.mod-field input{font-weight:700;font-size:1.1rem!important}
.hint{font-size:.86rem;color:var(--ink-3);margin-top:12px}

.timeline{}
.stage{position:relative}
.badge{width:38px;height:38px;border-radius:12px;background:var(--brand-soft);color:var(--brand);display:grid;place-items:center;font-weight:700;font-size:1.05rem;flex:none}
.stage.signed .badge{background:var(--ok);color:#fff}
.stage.locked{opacity:.5}
.state{margin-inline-start:auto;font-size:.8rem;font-weight:500;padding:4px 11px;border-radius:999px;background:var(--warn-soft);color:var(--warn)}
.stage.signed .state{background:var(--ok-soft);color:var(--ok)}
.decl{border:1px solid var(--line);background:var(--sunk);border-radius:14px;padding:14px 16px;margin:18px 0;display:flex;gap:12px;align-items:flex-start;cursor:pointer;transition:border-color .15s,background .15s}
.decl:has(input:checked){border-color:var(--brand);background:var(--brand-soft)}
.decl input{width:20px;height:20px;margin-top:2px;flex:none;accent-color:var(--brand)}
.decl span{font-weight:500;color:var(--ink)}
.sig .lbl{font-size:.84rem;color:var(--ink-2);margin-bottom:6px;display:flex;justify-content:space-between;align-items:center;font-weight:500;max-width:560px}
.pad{width:100%;max-width:560px;height:170px;border:1.5px dashed var(--line);border-radius:16px;background:#FFFFFF;touch-action:none;display:block;cursor:crosshair}
.signed-img{width:100%;max-width:420px;height:auto;border:1px solid var(--line);border-radius:16px;background:#fff;display:block}
.stamp{font-size:.86rem;color:var(--ok);font-weight:500;margin-top:8px}
.photos{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-top:12px}
.ph{position:relative;border-radius:14px;overflow:hidden;aspect-ratio:4/3;background:var(--sunk);border:1px solid var(--line)}
.ph a,.ph img{display:block;width:100%;height:100%}
.ph img{object-fit:cover}
.ph .x{position:absolute;top:8px;inset-inline-start:8px;border:0;border-radius:8px;background:rgba(10,15,28,.65);color:#fff;padding:3px 10px;cursor:pointer;font-size:.78rem;backdrop-filter:blur(6px)}
.ph .tag{position:absolute;bottom:8px;inset-inline:8px;border-radius:8px;background:rgba(10,15,28,.7);color:#fff;font-size:.76rem;padding:4px 8px;backdrop-filter:blur(6px)}
.ph.pending img{opacity:.5}
.ph.failed{border-color:var(--bad)} .ph.failed .tag{background:var(--bad)}
.drop{border:1.5px dashed var(--line);border-radius:16px;padding:22px;text-align:center;color:var(--brand);cursor:pointer;display:block;background:var(--sunk);font-weight:500;transition:all .15s}
.drop:hover{border-color:var(--brand);background:var(--brand-soft)}
.drop input{display:none}
.files{display:flex;flex-direction:column;gap:8px;margin-top:12px}
.file{display:flex;align-items:center;gap:12px;padding:10px 12px;border:1px solid var(--line);border-radius:14px;background:var(--sunk)}
.file img{width:60px;height:46px;object-fit:cover;border-radius:8px}
.file a{color:var(--brand);font-weight:500;text-decoration:none}
.file .sp{margin-inline-start:auto}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px;align-items:center}
.err{color:var(--bad);font-size:.9rem;font-weight:500}
.banners{display:flex;flex-direction:column;gap:8px;padding:14px 32px 0}
.banners:not(:has(.banner:not([hidden]))){display:none}
.banner{border-radius:12px;padding:10px 14px;font-weight:500;background:var(--warn-soft);color:var(--warn);font-size:.9rem}
.banner.bad{background:var(--bad-soft);color:var(--bad)}

.seal{margin:20px 32px 0;border-radius:18px;padding:18px 20px;display:flex;gap:16px;align-items:center;color:#fff;position:relative;overflow:hidden;
  background:radial-gradient(120% 160% at 100% 0%,rgba(45,91,255,.55),transparent 55%),radial-gradient(80% 120% at 0% 100%,rgba(18,194,233,.3),transparent 60%),var(--dark)}
.seal .medal{width:52px;height:52px;border-radius:14px;display:grid;place-items:center;flex:none;font-size:1.4rem;color:#fff;background:linear-gradient(135deg,var(--ok),#22C3A6)}
.seal b{font-size:1.1rem;font-weight:700;display:block}
.seal .t{color:rgba(255,255,255,.75);font-size:.9rem}
.seal .fp{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.76rem;color:rgba(255,255,255,.5);direction:ltr;unicode-bidi:isolate;word-break:break-all;margin-top:4px}
.seal.broken{background:var(--bad)} .seal.broken .medal{background:#fff;color:var(--bad)}

.log{font-size:.86rem;color:var(--ink-2);display:flex;flex-direction:column;gap:5px;max-height:240px;overflow:auto}
.log div{display:flex;gap:14px} .log time{min-width:120px;color:var(--ink-3);font-variant-numeric:tabular-nums}
details.logbox summary{cursor:pointer;font-weight:600}

/* ---------- Archive ---------- */
.archive{margin-top:56px}
.archive-h{display:flex;align-items:center;gap:16px;margin-bottom:20px;flex-wrap:wrap}
.archive-h h2{font-weight:800;font-size:2rem;margin:0;letter-spacing:-.02em}
.archive-h .grow{flex:1}
.search{border:1px solid var(--line);background:var(--surface);border-radius:12px;padding:11px 16px;min-width:min(340px,100%);box-shadow:var(--shadow-s)}
.search:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 4px color-mix(in srgb,var(--brand) 16%,transparent)}
.group{margin-bottom:30px}
.group-h{display:flex;align-items:center;gap:12px;margin:0 2px 12px;flex-wrap:wrap}
.group-h h3{margin:0;font-size:1.1rem;font-weight:700}
.group-h .meta{font-size:.8rem;color:var(--brand);background:var(--brand-soft);padding:3px 10px;border-radius:999px;font-weight:500}
.tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px}
.tile{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:16px;cursor:pointer;text-align:start;box-shadow:var(--shadow-s);transition:border-color .15s,box-shadow .15s,transform .15s;display:flex;flex-direction:column;gap:10px}
.tile:hover{border-color:var(--brand);box-shadow:0 10px 24px -14px rgba(45,91,255,.45);transform:translateY(-2px)}
.tile.active{border-color:var(--brand);box-shadow:0 0 0 3px color-mix(in srgb,var(--brand) 20%,transparent)}
.tile .top{display:flex;align-items:flex-start;gap:8px}
.tile .n{font-weight:700;font-size:1.25rem;line-height:1.2;letter-spacing:-.01em;word-break:break-word}
.tile .lock{margin-inline-start:auto;width:28px;height:28px;border-radius:9px;display:grid;place-items:center;font-size:.8rem;background:var(--ok-soft);flex:none}
.tile .bars{display:grid;grid-template-columns:repeat(4,1fr);gap:4px}
.tile .bars i{height:6px;border-radius:3px;background:var(--line-2)}
.tile .bars i.on{background:var(--brand)}
.tile.ready .bars i.on{background:var(--ok)}
.tile .m{font-size:.8rem;color:var(--ink-3)}
.tile .chip{align-self:flex-start;font-size:.78rem;font-weight:500;padding:3px 10px;border-radius:999px;background:var(--warn-soft);color:var(--warn)}
.tile.ready .chip{background:var(--ok-soft);color:var(--ok)}
.foot{display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin-top:18px;color:var(--ink-2);font-size:.85rem}
.meter{height:6px;border-radius:3px;background:var(--line-2);overflow:hidden;width:160px;display:inline-block}
.meter i{display:block;height:100%;background:linear-gradient(90deg,var(--brand),var(--cyan))}
.colophon{margin-top:56px;padding-top:20px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;color:var(--ink-3);font-size:.82rem;flex-wrap:wrap;gap:10px}
.colophon .wm-ico{width:26px;height:26px;border-radius:8px}.colophon .wm-ico svg{width:15px;height:15px}.colophon .wm-ico::after{display:none}
.colophon .wm-cx{font-size:1.05rem}.colophon .wm-el{font-size:.86rem}.colophon .wm-bar{height:13px}.colophon .wm-sub{display:none}

.toast{position:fixed;bottom:calc(20px + env(safe-area-inset-bottom,0px));left:50%;transform:translateX(-50%);background:var(--ink);color:var(--surface);padding:12px 18px;border-radius:14px;font-size:.93rem;opacity:0;pointer-events:none;transition:opacity .2s;z-index:20;max-width:90vw;box-shadow:0 12px 30px -10px rgba(10,15,28,.5)}
.toast.on{opacity:1}

/* ---------- Reliability + polish ---------- */
.stage.signed{background:linear-gradient(180deg,color-mix(in srgb,var(--ok-soft) 75%,transparent),transparent 150px)}
.stage.signed .badge{font-size:1.1rem}
.fwarn{color:var(--bad);font-size:.8rem;font-weight:500}
.fwarn.soon{color:var(--warn)}
.tile .chip.draft{background:var(--brand-soft);color:var(--brand)}
.sync.off .dot{background:var(--ink-3)}
.seal .btn{margin-inline-start:auto;background:#fff;color:#0A0F1C;border:0;flex:none}
.banner.info{background:var(--brand-soft);color:var(--brand)}
@media (max-width:480px){.topbar-in{padding:10px 14px;gap:10px}.views button{padding:6px 10px;font-size:.85rem}.ghost{padding:6px 10px}}
/* ---------- Status dashboard ---------- */
.views{display:inline-flex;background:var(--sunk);border:1px solid var(--line);border-radius:12px;padding:3px;gap:2px}
.views button{border:0;background:transparent;border-radius:9px;padding:6px 14px;font-weight:500;font-size:.9rem;color:var(--ink-2);cursor:pointer;white-space:nowrap}
.views button[aria-pressed="true"]{background:var(--surface);color:var(--ink);box-shadow:var(--shadow-s)}
#dash{padding-top:36px}
.dh{display:flex;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:22px}
.dh h1{font-weight:800;font-size:clamp(2rem,4.6vw,3.1rem);line-height:1.05;letter-spacing:-.025em;margin:0}
.dh h1 em{font-style:normal;background:linear-gradient(90deg,var(--brand),var(--cyan));-webkit-background-clip:text;background-clip:text;color:transparent}
.dh p{color:var(--ink-2);margin:10px 0 0}
.dh .grow{flex:1}
.pills{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.pills button{border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:6px 14px;font-size:.88rem;font-weight:500;cursor:pointer;color:var(--ink-2)}
.pills button[aria-pressed="true"]{background:var(--ink);color:var(--surface);border-color:var(--ink)}
.pills .pl{font-size:.82rem;color:var(--ink-3);margin-inline-end:4px}
.kpi{display:grid;grid-template-columns:1.3fr repeat(3,1fr);gap:12px;margin-bottom:16px}
.kpi .card{padding:18px 20px;border-radius:20px}
.kpi .g{display:flex;align-items:center;gap:18px}
.gauge{--p:0;width:112px;height:112px;border-radius:50%;background:conic-gradient(var(--ok) calc(var(--p)*1%),var(--line-2) 0);display:grid;place-items:center;flex:none;transition:background .5s}
.gauge span{width:90px;height:90px;border-radius:50%;background:var(--surface);display:grid;place-items:center;font-weight:800;font-size:1.6rem;font-variant-numeric:tabular-nums}
.kpi .g b{font-size:1.15rem;font-weight:700;display:block}
.kpi .g small{color:var(--ink-2);font-size:.88rem}
.kc .v{font-size:2.3rem;font-weight:700;line-height:1;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.kc .k{color:var(--ink-2);font-size:.85rem;margin-top:8px}
.kc.bad .v{color:var(--bad)} .kc.warn .v{color:var(--warn)}
@media (max-width:820px){.kpi{grid-template-columns:1fr 1fr 1fr}.kpi .g{grid-column:1/-1}}
@media (max-width:520px){.kpi{grid-template-columns:1fr 1fr}.kpi .kc:last-child{grid-column:1/-1}}
.dsec{padding:24px 28px;margin-bottom:16px}
.dsec h2{font-weight:700;font-size:1.2rem;margin:0 0 4px;letter-spacing:-.01em}
.dsec .sub{color:var(--ink-3);font-size:.88rem;margin:0 0 16px}
.pipe{display:flex;height:14px;border-radius:7px;overflow:hidden;background:var(--line-2);gap:2px}
.pipe i{display:block;height:100%;transition:width .5s}
.stages{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-top:14px}
.stg{border:1px solid var(--line);background:var(--sunk);border-radius:14px;padding:12px 14px;text-align:start;cursor:pointer;position:relative;overflow:hidden;color:var(--ink)}
.stg::before{content:"";position:absolute;inset:0 0 auto;height:4px;background:var(--c)}
.stg[aria-pressed="true"]{border-color:var(--brand);box-shadow:0 0 0 3px color-mix(in srgb,var(--brand) 18%,transparent);background:var(--surface)}
.stg b{display:block;font-size:1.7rem;font-weight:700;line-height:1.1;font-variant-numeric:tabular-nums;margin-top:4px}
.stg span{font-size:.8rem;color:var(--ink-2)}
@media (max-width:640px){.stages{grid-template-columns:repeat(2,1fr)}.dsec{padding:20px 18px}}
.mx-row{padding:14px 0;border-top:1px solid var(--line-2)}
.mx-row:first-of-type{border-top:0;padding-top:4px}
.mx-h{display:flex;justify-content:space-between;align-items:baseline;gap:10px;margin-bottom:10px;font-size:.92rem}
.mx-h b{font-weight:600}
.mx-h span{color:var(--ink-3);font-size:.82rem;font-variant-numeric:tabular-nums}
.cells{display:flex;flex-wrap:wrap;gap:6px}
.cell{min-width:48px;height:40px;padding:0 10px;border-radius:10px;border:0;background:var(--c);color:var(--tc,#fff);font-weight:600;font-size:.84rem;cursor:pointer;font-variant-numeric:tabular-nums;transition:opacity .2s,transform .15s;position:relative}
.cell.new{background:var(--sunk);color:var(--ink-2);box-shadow:inset 0 0 0 1px var(--line)}
.cell.dim{opacity:.18}
.cell:hover{transform:translateY(-2px)}
.cell.flag::after{content:"";position:absolute;top:-3px;inset-inline-end:-3px;width:10px;height:10px;border-radius:50%;background:var(--bad);box-shadow:0 0 0 2px var(--surface)}
.cell.idle{outline:2px dashed var(--warn);outline-offset:2px}
.lg{display:flex;gap:14px;flex-wrap:wrap;font-size:.82rem;color:var(--ink-2);margin-top:14px}
.lg i{display:inline-block;width:11px;height:11px;border-radius:3px;margin-inline-end:6px;vertical-align:-1px}
.att{display:grid;grid-template-columns:1fr auto;gap:8px 14px;align-items:center;padding:14px 0;border-top:1px solid var(--line-2)}
.att:first-of-type{border-top:0;padding-top:2px}
.att .n{font-weight:700;font-size:1.05rem}
.att .w{color:var(--ink-3);font-size:.84rem}
.att .cf{grid-column:1/-1;display:flex;gap:6px;flex-wrap:wrap}
.chipf{font-size:.77rem;padding:3px 10px;border-radius:999px;font-weight:500;background:var(--brand-soft);color:var(--brand)}
.chipf.bad{background:var(--bad-soft);color:var(--bad)} .chipf.warn{background:var(--warn-soft);color:var(--warn)}
.pace{display:grid;grid-template-columns:1fr auto;gap:20px;align-items:end}
.bars14{display:flex;align-items:flex-end;gap:5px;height:84px}
.bars14 i{flex:1;background:linear-gradient(var(--cyan),var(--brand));border-radius:5px 5px 2px 2px;min-height:3px;position:relative}
.bars14 i.z{background:var(--line-2)}
.bars14x{display:flex;justify-content:space-between;font-size:.74rem;color:var(--ink-3);margin-top:6px;font-variant-numeric:tabular-nums}
.pace .big{font-size:2.3rem;font-weight:700;line-height:1;font-variant-numeric:tabular-nums}
.pace .big small{font-size:.9rem;font-weight:500;color:var(--ink-2)}
@media (max-width:600px){.pace{grid-template-columns:1fr}}
@media (max-width:760px){ .hero{grid-template-columns:1fr;padding-top:28px} }
@media (max-width:600px){
  .cl-head{grid-template-columns:1fr auto;padding:22px 18px 18px} .ring{width:68px;height:68px} .ring span{width:54px;height:54px;font-size:1rem}
  .sec,.toolbar{padding-inline:18px} .banners{padding-inline:18px} .seal{margin-inline:18px}
  .topbar .prod,.topbar .sep{display:none} .stat .v{font-size:1.6rem}
}
@media (prefers-reduced-motion: reduce){*{transition:none!important;animation:none!important}}

.cells{display:grid;gap:10px}
.cellrow{display:flex;align-items:center;gap:12px;flex-wrap:wrap;min-height:64px;padding:14px 18px;border:1px solid var(--line);border-radius:16px;background:var(--surface)}
.cellrow.click{cursor:pointer}.cellrow.click:hover{border-color:var(--brand);background:var(--brand-soft)}
.cellrow .cn{font-weight:700;font-size:1.02rem;color:var(--ink)}
.cellrow .cs{font-size:.78rem;font-weight:500;color:var(--warn)}
.cellrow .cs.ok{color:var(--ok)}.cellrow .cs.bad{color:var(--bad)}
.cellrow .cth{display:block;width:72px;height:54px;border-radius:10px;overflow:hidden;border:1px solid var(--line);background:var(--sunk)}
.cellrow .cth img{width:100%;height:100%;object-fit:cover;display:block}
.cellrow .acts{margin-inline-start:auto;display:flex;gap:8px;flex-wrap:wrap}
.addcell{margin-top:12px;border-radius:14px}
.grph{font-weight:700;font-size:.9rem;color:var(--brand);margin:14px 2px 2px;padding-bottom:4px;border-bottom:2px solid var(--brand-soft)}
.grph:first-child{margin-top:0}
.cellrow .scan{display:inline-flex;align-items:center;gap:8px;font-size:.84rem;font-weight:500;color:var(--ink-2);cursor:pointer;padding:6px 10px;border:1px solid var(--line);border-radius:10px;background:var(--sunk)}
.cellrow .scan:has(input:checked){border-color:var(--ok);background:var(--ok-soft);color:var(--ok)}
.cellrow .scan input{width:18px;height:18px;accent-color:var(--ok);margin:0}
.s2prog{font-size:.86rem;font-weight:600;color:var(--warn);margin:0 0 10px}
.s2prog.ok{color:var(--ok)}
.gate{margin:16px 0 0;padding:12px 14px;border-radius:14px;border:1px solid var(--warn);background:var(--warn-soft);font-size:.88rem;color:var(--ink)}
.gate.ok{border-color:var(--ok);background:var(--ok-soft)}
.gate.wait{border-color:var(--line);background:var(--sunk);color:var(--ink-2)}
.gate b{display:block;margin-bottom:6px}
.gate ul{margin:0;padding:0 18px 0 0}
.gate li{margin:2px 0}
.clean{margin-top:14px}
.clean .decl{margin:8px 0}
</style>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
</head>
<body>

<header class="topbar">
  <div class="topbar-in">
    <div class="logo-slot" id="logoSlot"><span class="wordmark" aria-label="CX-ELECTRA"><span class="wm-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M13.6 1.8 4.6 13.4h6l-1.1 8.8 9.4-12h-6.1l.8-8.4z"/></svg></span><span class="wm-txt" aria-hidden="true"><span class="wm-main"><span class="wm-cx">CX</span><span class="wm-bar"></span><span class="wm-el">ELECTRA</span></span><span class="wm-sub">Electrical Commissioning</span></span></span></div>
    <span class="sep"></span><span class="prod">מערכות אל־פסק</span>
    <span class="grow"></span>
    <nav class="views" aria-label="תצוגה"><button type="button" data-view="cl" aria-pressed="true">צ׳קליסט</button><button type="button" data-view="dash" aria-pressed="false">תמונת מצב</button></nav>
  </div>
</header>
<section class="hero" id="hero">
  <div>
    <h1>צ׳קליסט מוכנות<br><em>לבדיקות בעומס למערכות אל־פסק</em></h1>
    <p>חיזוק במד מומנט, ניקיון תאים ואישור בודק לכל מודול. נחתם, מתועד וננעל.</p>
  </div>
  <div class="stats">
    <div class="stat"><div class="v" id="stTotal">0</div><div class="k">מודולים</div></div>
    <div class="stat"><div class="v" id="stProg">0</div><div class="k">בתהליך</div></div>
    <div class="stat go"><div class="v" id="stReady">0</div><div class="k">מוכנים לעומס</div></div>
  </div>
</section>

<main class="wrap">
  <section id="dash" hidden></section>
  <article class="card" id="checklist">
    <div class="cl-head">
      <div>
        <div class="cl-title"><span class="mlabel">שם המודול</span><span class="mnum" id="mNum">צ׳קליסט חדש</span><span class="msub" id="mSub"></span></div>
      </div>
      <div class="ring" id="ring"><span id="ringTxt">0/4</span></div>
      <div class="statusline" id="statusLine"><span class="lamp"></span><span id="statusTxt">מלא את פרטי המודול כדי להתחיל</span></div>
    </div>
    <div class="toolbar">
      <button class="btn" id="newBtn">צ׳קליסט חדש</button>
      <button class="btn brass" id="pdfBtn">⬇ טופס ריק להדפסה (PDF)</button>
      <span class="grow"></span>
      <span class="sync" id="sync"><span class="dot"></span><span id="syncText">מתחבר…</span></span>
    </div>
    <div class="banners" id="banners">
      <div class="banner bad" id="noDb" hidden>אין גישה לאחסון המקומי של הדפדפן, ולכן לא ניתן לשמור.</div>
      <div class="banner" id="noAssets" hidden>אין לך הרשאה להעלות קבצים. בקש מבעל הכלי לשתף אותך בהרשאת עריכה.</div>
      <div class="banner" id="pendingBanner" hidden></div>
      <div class="banner info" id="draftBanner" hidden></div>
    </div>
    <div id="sealBox"></div>

    <section class="sec" id="hdr">
      <div class="sec-h"><h2>פרטי המודול</h2></div>
      <div class="grid">
        <label class="f mod-field"><span class="req">שם המודול</span><input id="module" autocomplete="off"></label>
        <label class="f"><span class="req">אתר</span><input id="site" autocomplete="off"></label>
        <label class="f"><span class="req">רביע</span><input id="quadrant" autocomplete="off"></label>
      </div>
      <div class="hint" id="hdrHint">הצ׳קליסט נשמר אוטומטית מרגע שכל השדות המסומנים מולאו.</div>
    </section>

    <div class="timeline">
    <section class="sec stage" id="st1">
      <div class="sec-h"><span class="badge">1</span><h2>חיזוק כניסות ויציאות במד מומנט</h2><span class="state" id="st1state"></span></div>
      <div class="grid">
        <label class="f"><span class="req">שם מפעיל תדיראן</span><input data-f="name" autocomplete="off"></label>
        <label class="f"><span>מספר עובד / ת״ז</span><input data-f="empId" autocomplete="off"></label>
        <label class="f"><span>מס׳ מד מומנט</span><input data-f="tool" autocomplete="off"></label>
        <label class="f"><span>תוקף כיול מד המומנט</span><input data-f="calib" type="date"><span class="fwarn" id="calibWarn" hidden></span></label>
      </div>
      <label class="f" style="margin-top:14px"><span>הערות</span><textarea data-f="notes"></textarea></label>
      <label class="decl"><input type="checkbox" data-f="declared"><span class="dtext">אני, מפעיל תדיראן החתום מטה, מצהיר כי כל הכניסות והיציאות של המודול עברו חיזוק במד מומנט בהתאם לערכים הנדרשים.</span></label>
      <div class="gate" id="gate1" hidden></div>
      <div class="sig" data-sig="s1"></div>
      <div class="actions"><button class="btn primary" data-sign="1"></button><span class="err" id="s1err"></span></div>
    </section>

    <section class="sec stage" id="st2">
      <div class="sec-h"><span class="badge">2</span><h2>ניקיון יסודי של התאים</h2><span class="state" id="st2state"></span></div>
      <div class="grid">
        <label class="f"><span class="req">שם האחראי שביצע את הניקיון</span><input data-f="name" autocomplete="off"></label>
        <label class="f"><span>תפקיד / חברה</span><input data-f="role" autocomplete="off"></label>
        <label class="f"><span class="req">תאריך ביצוע הניקיון</span><input data-f="date" type="date"></label>
      </div>
      <div style="margin-top:14px">
        <div class="hint req" style="margin:0 0 8px" id="s2hint"></div>
        <div class="s2prog" id="s2prog"></div>
        <div class="cells" id="s2photos"></div>
        <button type="button" class="btn addcell" id="addCell">הוסף תא +</button>
        <input type="file" id="s2files" accept="image/*" hidden>
      </div>
      <label class="f" style="margin-top:14px"><span>הערות</span><textarea data-f="notes"></textarea></label>
      <label class="decl"><input type="checkbox" data-f="declared"><span class="dtext">אני מאשר כי ביצעתי ניקיון יסודי של כל הפריטים במודול (תאים, גופי ה־UPS והתקרות), בוצעה סריקה פיזית לכל פריט, והתמונות המצורפות משקפות את מצבם לאחר הניקיון.</span></label>
      <div class="gate" id="gate2" hidden></div>
      <div class="sig" data-sig="s2"></div>
      <div class="actions"><button class="btn primary" data-sign="2"></button><span class="err" id="s2err"></span></div>
    </section>

    <section class="sec stage" id="st4">
      <div class="sec-h"><span class="badge">3</span><h2>איטומי אש</h2><span class="state" id="st4state"></span></div>
      <div class="grid">
        <label class="f"><span class="req">שם האחראי על איטומי האש</span><input data-f="name" autocomplete="off"></label>
        <label class="f"><span>תפקיד / חברה</span><input data-f="role" autocomplete="off"></label>
        <label class="f"><span class="req">תאריך ביצוע איטומי האש</span><input data-f="date" type="date"></label>
      </div>
      <div style="margin-top:14px">
        <div class="hint req" style="margin:0 0 8px">תמונות איטומי האש לאחר הביצוע (עד 20MB לתמונה; נשמרת מכווצת עד 1800 פיקסלים)</div>
        <label class="drop" id="s4drop"><input type="file" id="s4files" accept="image/*" multiple>צלם / בחר תמונות</label>
        <div class="files" id="s4list"></div>
      </div>
      <label class="f" style="margin-top:14px"><span>הערות</span><textarea data-f="notes"></textarea></label>
      <label class="decl"><input type="checkbox" data-f="declared"><span class="dtext">אני, האחראי על איטומי האש, מצהיר כי בוצעו איטומי אש בכל המעברים והחדירות הנדרשים במודול, והתמונות המצורפות משקפות את מצבם לאחר הביצוע.</span></label>
      <div class="gate" id="gate4" hidden></div>
      <div class="sig" data-sig="s4"></div>
      <div class="actions"><button class="btn primary" data-sign="4"></button><span class="err" id="s4err"></span></div>
    </section>

    <section class="sec stage" id="st3">
      <div class="sec-h"><span class="badge">3</span><h2>אישור בודק ומעבר לבדיקות בעומס</h2><span class="state" id="st3state"></span></div>
      <div class="grid">
        <label class="f"><span class="req">שם מתאם תדיראן האחראי</span><input data-f="name" autocomplete="off"></label>
        <label class="f"><span class="req">שם הבודק</span><input data-f="inspector" autocomplete="off"></label>
        <label class="f"><span>מספר אישור בודק</span><input data-f="no" autocomplete="off"></label>
        <label class="f"><span>תאריך אישור הבודק</span><input data-f="date" type="date"></label>
      </div>
      <div style="margin-top:14px">
        <div class="hint" style="margin:0 0 8px">אישור הבודק (תמונה או PDF, עד 20MB לקובץ)</div>
        <label class="drop" id="s3drop"><input type="file" id="s3files" accept="image/*,application/pdf" multiple>בחר קבצים</label>
        <div class="files" id="s3list"></div>
      </div>
      <div class="clean">
        <div class="hint req" style="margin:0 0 4px">דוחות בודק נקיים: תנאי למעבר לבדיקות בעומס</div>
        <label class="decl"><input type="checkbox" data-f="clean1"><span class="ctext">דוח הבודק ל־UPS 1 צורף, ואין בו ליקויים פתוחים.</span></label>
        <label class="decl"><input type="checkbox" data-f="clean2"><span class="ctext">דוח הבודק ל־UPS 2 צורף, ואין בו ליקויים פתוחים.</span></label>
      </div>
      <label class="decl"><input type="checkbox" data-f="declared"><span class="dtext">אני, מתאם תדיראן האחראי, מתחייב כי עברתי על אישור הבודק למודול, ולמיטב הבנתי המודול תקין ומוכן לעבור לשלב הבדיקות בעומס.</span></label>
      <div class="gate" id="gate3" hidden></div>
      <div class="sig" data-sig="s3"></div>
      <div class="actions"><button class="btn primary" data-sign="3"></button><span class="err" id="s3err"></span></div>
      <div class="hint" id="finalHint">חתימה על שלב זה נועלת את הצ׳קליסט כולו לצמיתות.</div>
    </section>
    </div>

    <section class="sec" id="logSec" hidden>
      <details class="logbox"><summary>יומן פעולות</summary><div class="log" id="log" style="margin-top:10px"></div></details>
    </section>
  </article>

  <section class="archive" id="archive">
    <div class="archive-h"><h2>צ׳קליסטים</h2><span class="grow"></span><input class="search" id="search" placeholder="חיפוש לפי אתר, מספר סידורי או מודול" aria-label="חיפוש"></div>
    <div id="list"><p class="hint">טוען…</p></div>
    <div class="foot"><button class="btn small" id="backupBtn" hidden>הורד גיבוי מלא (JSON)</button><span id="storage"></span></div>
  </section>
  <footer class="colophon"><span class="wordmark" aria-label="CX-ELECTRA"><span class="wm-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M13.6 1.8 4.6 13.4h6l-1.1 8.8 9.4-12h-6.1l.8-8.4z"/></svg></span><span class="wm-txt" aria-hidden="true"><span class="wm-main"><span class="wm-cx">CX</span><span class="wm-bar"></span><span class="wm-el">ELECTRA</span></span><span class="wm-sub">Electrical Commissioning</span></span></span><span>כל צ׳קליסט נעול נחתם בחותמת דיגיטלית SHA-256</span></footer>
</main>
<div class="toast" id="toast" role="status"></div>

<script>
/* ===== CX-ELECTRA standalone runtime: replaces the Claude-hosted db / assets / downloads / user services =====
   All data lives in this browser (IndexedDB). Nothing is sent to any server. */
(function(){
'use strict';
const DB_NAME='cx-electra-standalone';
const clone=o=>o===undefined?undefined:JSON.parse(JSON.stringify(o));
const docs=new Map(), assetMeta=new Map(), urls=new Map();
let idb=null, persistent=true;

/* ---- cloud sync: Firebase Realtime Database (same project as Electra CX), separate namespace ---- */
