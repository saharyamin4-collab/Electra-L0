    return secs;
  }
  function showDraftBanner(t){ const b=$('draftBanner'); b.hidden=!t; if(t) b.textContent=t; clearTimeout(showDraftBanner.h); if(t) showDraftBanner.h=setTimeout(()=>{b.hidden=true;},12000); }

