    const data={...clone(S.draft),publishedAt:Date.now()};
    if(S.mode==='live'){if(!await writeDoc('config/schedule',data))return;toast('הסידור פורסם לצוות')}else{LS.set('cx_schedule',data);toast('הסידור נשמר. העתק אותו כטקסט ושלח לצוות')}
    S.schedule=data;try{localStorage.setItem('cx_seen_pub',String(data.publishedAt))}catch(e){}render();
    if(S.mode==='live'){
      const r=await sendPush({title:'פורסם סידור משמרות חדש',body:'שבוע '+rangeLabel(S.settings)+'. לחץ כדי לראות את המשמרות שלך',url:appUrl('#sched'),tag:'cx-schedule'});
      if(r.skipped)toast('הסידור פורסם. כדי לשלוח גם התראות לטלפונים, הגדר שרת התראות בלשונית ניהול');
      else if(r.error)toast('הסידור פורסם, אבל שליחת ההתראות נכשלה ('+r.error+')');
      else toast('הסידור פורסם. '+pushResultText(r))}},
  copySched(b){const sc=b&&b.dataset&&b.dataset.src==='pub'?S.schedule:S.draft;if(!sc)return;copyText(schedText(sc),'הסידור הועתק. אפשר להדביק בוואטסאפ')},
  async waShare(b){await waQuick(b)},
  async importCodes(){const ta=document.getElementById('codes');const items=decodeCodes(ta.value);if(!items.length){toast('לא נמצא קוד תקין. ודא שהעתקת את כל הקוד, כולל CXE:');return}
    for(const it of items){const p=normPrefs(it.p);const id=String(it.id).replace(/[^A-Za-z0-9_\-]/g,'').slice(0,40)||('x-'+Math.random().toString(36).slice(2,8));
      if(S.mode==='live'){await writeDoc('prefs/'+id,p)}else S.team[id]=p}
    if(S.mode==='local')LS.set('cx_team',S.team);ta.value='';render();toast(items.length===1?'נוסף איש צוות אחד':`נוספו ${items.length} אנשי צוות`)},
  async removePerson(b){const id=b.dataset.id;if(S.mode==='live'){try{await S.db.doc('prefs/'+id).delete()}catch(e){toast('ההסרה נכשלה')}}else{delete S.team[id];LS.set('cx_team',S.team)}render()},
  unlock(){const el=document.getElementById('pin');if(!el)return;if(hash('cxe-pin-'+el.value.trim())===PIN_H){S.unlocked=true;try{sessionStorage.setItem('cx_unlock','1')}catch(e){}watchTeam();render();toast('ברוך הבא, מנהל')}else{el.value='';el.classList.remove('bad');void el.offsetWidth;el.classList.add('bad');toast('קוד שגוי');el.focus()}},
  diag(){runDiag()},
  retry(){location.reload()},
  switchUser(){try{localStorage.removeItem('cx_ident')}catch(e){}location.reload()},
  lock(){S.unlocked=false;S.moving=null;try{sessionStorage.removeItem('cx_unlock')}catch(e){}render()},
  closeModal(){document.getElementById('modal').innerHTML=''}
};
const B={
  name(t){S.me.name=t.value;markDirty()},
  note(t){S.me.note=t.value;markDirty()},
  start(t){if(t.value)S.setDraft.start=t.value},
  deadline(t){S.setDraft.deadline=t.value},
  frih(t){if(t.value){S.setDraft.fri.hours[+t.dataset.i]=t.value;updDur()}},
  pushurl(t){S.pcfg=S.pcfg||pushCfg();S.pcfg.url=t.value.trim()},
  pushsecret(t){S.pcfg=S.pcfg||pushCfg();S.pcfg.secret=t.value.trim()},
  hour(t){if(t.value){S.setDraft.hours[t.dataset.sh][+t.dataset.i]=t.value;updDur()}}
};
document.addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(!b||b.disabled)return;if(b.dataset.action==='closeModal'&&e.target!==b&&!e.target.closest('button'))return;const f=A[b.dataset.action];if(f){try{if(navigator.vibrate&&!/^(sheetClose|imgClose)$/.test(b.dataset.action))navigator.vibrate(6)}catch(_){}f(b,e)}});
document.addEventListener('keydown',e=>{const t=e.target;if(e.key==='Enter'&&t.dataset&&t.dataset.enter&&A[t.dataset.enter]){e.preventDefault();A[t.dataset.enter](t)}});
document.addEventListener('input',e=>{const t=e.target;if(t.dataset&&t.dataset.bind&&B[t.dataset.bind])B[t.dataset.bind](t)});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&document.getElementById('imgmodal'))imgClose()});
init();
</script>
</body>
</html>
