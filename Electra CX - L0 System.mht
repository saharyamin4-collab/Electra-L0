    SECS.forEach(k=>{ if(!cur[k].sig) d.secs[k]=readSec(k); });
    if(!cur.id){ const any=Object.values(d.hdr).some(Boolean)||SECS.some(k=>d.secs[k]&&Object.entries(d.secs[k]).some(([f,v])=>f!=='declared'&&v)); if(!any){ dropDraft(null); return; } }
    try{ localStorage.setItem(dkey(cur.id),JSON.stringify(d)); }catch(_){}
  }
  function maybeClearDraft(){ if(cur&&!Object.values(dirty).some(Boolean)) dropDraft(cur.id); }
  function applyDraft(id){
