function rolesFor(s,w,sh,ids,team){
  const slots=slotRoles(s,w,sh),out={};if(!ids.length)return out;
  const m=Math.max(ids.length,slots.length);
  const cost=ids.map(id=>Array.from({length:m},(_,j)=>{const r=slots[j];if(!r)return .5;return canDo(team[id],r)?0:5}));
  const asg=hungarian(cost);
  ids.forEach((id,i)=>{const r=slots[asg[i]];out[id]=(r&&canDo(team[id],r))?r:(capsOf(team[id]).includes('insp')?'insp':'load')});
  return out}
function recomputeRoles(sc,s,team){s=s||S.settings;team=team||teamAll();sc.roles={};
  Object.keys(sc.days).forEach(k=>{const w=parseYmd(k).getDay();const r={};dayShifts(w).forEach(sh=>Object.assign(r,rolesFor(s,w,sh,sc.days[k][sh]||[],team)));sc.roles[k]=r})}
