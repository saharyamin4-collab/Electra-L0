    const d=document.createElement('div'); const ok=!sealState||sealState.ok;
    d.className='seal'+(ok?'':' broken');
    d.innerHTML='<div class="medal">'+(ok?'✓':'!')+'</div><div><b></b><div class="t"></div><div class="fp"></div></div>';
    d.querySelector('b').textContent= ok?'הצ׳קליסט נעול וחתום':'אזהרת שלמות';
    d.querySelector('.t').textContent= ok? ('ננעל ב־'+fmt(cur.seal&&cur.seal.at)+(sealState?' / השלמות אומתה':' / מאמת שלמות…')) : sealState.why;
    d.querySelector('.fp').textContent= cur.seal? 'SHA-256 '+cur.seal.hash : 'נעול ללא חותמת דיגיטלית';
    box.appendChild(d);
    if(!cur.seal&&me&&cur.s3&&cur.s3.signedBy===me&&db){ const b=document.createElement('button'); b.type='button'; b.className='btn small'; b.textContent='השלם חותמת דיגיטלית'; b.onclick=completeSeal; d.appendChild(b); }
  }
  async function completeSeal(){
    if(!cur||!isFinal(cur)||cur.seal||!me) return; const id=cur.id;
    toast('מחשב חותמת דיגיטלית…');
    const shas=await fileShas(cur), data=canon(cur,shas), hash=await sha(stable(data)), at=Date.now(), path='final/'+me+'/sealed/'+id;
    let ok=false; for(let i=0;i<4&&!ok;i++){ try{ await db.doc(path).set({hash,at,by:me,shas,data,late:true}); ok=true; }catch(_){ await sleep(1000*2**i); } }
    if(!ok){ toast('שמירת החותמת נכשלה. נסה שוב כשיש חיבור.'); return; }
    const info={path,hash,at,late:true};
    if(await writeRetry(id,{seal:info,log:logEntry('חותמת דיגיטלית הושלמה / '+hash.slice(0,12))})){ if(cur&&cur.id===id){ cur.seal=info; verify(); } toast('החותמת הדיגיטלית נשמרה'); }
  }

  /* ---------- local drafts: every unsaved edit is also kept on this device ---------- */
  const norm=v=>String(v==null?'':v).trim().replace(/\s+/g,' ').toLowerCase();
  const ver={};
  const dkey=id=>'cxd:'+(id||'new');
  function readDraft(id){ try{ const v=localStorage.getItem(dkey(id)); return v?JSON.parse(v):null; }catch(_){ return null; } }
  function dropDraft(id){ try{ localStorage.removeItem(dkey(id)); }catch(_){} }
  const hasDraft=id=>{ try{ return localStorage.getItem(dkey(id))!=null; }catch(_){ return false; } };
  function saveDraft(){
    if(!cur||isFinal(cur)) return;
