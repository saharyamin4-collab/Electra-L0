/* ---------- schedule as image ---------- */
const IMGFF='"IBM Plex Sans Hebrew","Heebo","Noto Sans Hebrew",system-ui,Arial,sans-serif';
const IMGSH={morning:{c:'#C98A10',s:'#FBF1DC'},afternoon:{c:'#1B7FB0',s:'#E1F0F8'},evening:{c:'#5B4DC9',s:'#ECE9FA'}};
const IMGRC={insp:'#2F6FB5',load:'#C8741A',night:'#2F6FB5'};
function imgModel(sc){
  const keys=Object.keys(sc.days||{}).sort();
  const hrsFor=(w,sh)=>hrsOf(S.settings,w,sh);
  const days=keys.map(k=>{const d=parseYmd(k),w=d.getDay(),rl=(sc.roles||{})[k]||null;
    return{key:k,label:DAYN[w],date:dm(d),shifts:dayShifts(w).map(sh=>({sh,hours:hrsFor(w,sh),people:sortByRole(sc.days[k][sh]||[],rl).map(id=>({name:sc.people[id]||'?',role:rl&&rl[id]||null}))}))}});
  const range=keys.length?(keys.length===1?dm(parseYmd(keys[0])):dm(parseYmd(keys[0]))+'–'+dm(parseYmd(keys[keys.length-1]))):'';
  return{days,range}}
function imgRR(ctx,x,y,w,h,r){ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath()}
async function schedCanvas(sc){
  try{await Promise.race([Promise.all([document.fonts.load('600 26px "IBM Plex Sans Hebrew"'),document.fonts.load('400 20px "IBM Plex Sans Hebrew"')]),new Promise(r=>setTimeout(r,2500))])}catch(e){}
  const m=imgModel(sc),N=Math.max(1,m.days.length);
  const PAD=40,LAB=230,COL=276,LH=50,CPAD=18,MINH=156,HEAD=190,DAYH=92,FOOT=130,GAP=10;
  const W=PAD*2+LAB+N*COL;
  const rows=SH.filter(sh=>m.days.some(d=>d.shifts.some(x=>x.sh===sh))).map(sh=>{const lines=Math.max(1,...m.days.map(d=>{const x=d.shifts.find(y=>y.sh===sh);return x?x.people.length:0}));return{sh,h:Math.max(MINH,lines*LH+CPAD*2)}});
  const H=HEAD+DAYH+12+rows.reduce((a,r)=>a+r.h+GAP,0)+FOOT;
  const cv=document.createElement('canvas');cv.width=W;cv.height=H;const ctx=cv.getContext('2d');
  const T=(t,x,y,o)=>{o=o||{};ctx.font=(o.w||400)+' '+(o.s||24)+'px '+IMGFF;ctx.fillStyle=o.c||'#1B1A17';ctx.direction=o.dir||'rtl';ctx.textAlign=o.a||'right';ctx.textBaseline='middle';ctx.fillText(t,x,y)};
  const MW=(t,sz,w)=>{ctx.font=w+' '+sz+'px '+IMGFF;return ctx.measureText(t).width};
  const FIT=(t,maxw,sz,w)=>{let z=sz;while(MW(t,z,w)>maxw&&z>14)z--;return z};
  let NSZ=28;m.days.forEach(d=>d.shifts.forEach(c=>c.people.forEach(p=>{const pw=p.role?MW(ROLESHORT[p.role],19,700)+22:0;NSZ=Math.min(NSZ,FIT(p.name,COL-12-32-(pw?pw+10:0),28,700))})));
  ctx.fillStyle='#F5F2EC';ctx.fillRect(0,0,W,H);
  ctx.fillStyle='#14213D';ctx.fillRect(0,0,W,HEAD);
  ctx.fillStyle='#E7A93A';ctx.fillRect(0,HEAD-8,W,8);
  T('סידור משמרות',W-PAD,70,{s:62,w:700,c:'#FFFFFF'});
  T('CXelectra · אתר בית שמש MDCIL4',W-PAD,138,{s:30,w:500,c:'#E7A93A'});
  T('שבוע '+m.range,PAD,70,{s:44,w:700,c:'#FFFFFF',a:'left',dir:'ltr'});
  const x0=W-PAD-LAB,dayX=i=>x0-(i+1)*COL;
  let y=HEAD+22;
  m.days.forEach((d,i)=>{const x=dayX(i)+6;imgRR(ctx,x,y,COL-12,DAYH-18,14);ctx.fillStyle='#FFFFFF';ctx.fill();ctx.strokeStyle='#DDD6C8';ctx.lineWidth=2;ctx.stroke();
    T(d.label,x+(COL-12)/2,y+26,{s:32,w:700,a:'center'});T(d.date,x+(COL-12)/2,y+54,{s:24,w:500,c:'#6B665C',a:'center',dir:'ltr'})});
  y=HEAD+DAYH+12;
  rows.forEach(r=>{const col=IMGSH[r.sh];
    imgRR(ctx,x0+6,y,LAB-6,r.h,14);ctx.fillStyle=col.s;ctx.fill();ctx.fillStyle=col.c;ctx.fillRect(x0+LAB-12,y+10,8,r.h-20);
    const cx=x0+6+(LAB-24)/2;T(SHL[r.sh],cx,y+r.h/2-34,{s:38,w:700,c:col.c,a:'center'});
    const hr=((m.days.find(d=>d.shifts.some(x=>x.sh===r.sh))||{shifts:[]}).shifts.find(x=>x.sh===r.sh)||{}).hours||'';
    T(hr,cx,y+r.h/2+8,{s:28,w:600,c:'#1B1A17',a:'center',dir:'ltr'});
    if(r.sh==='evening')T('בדיקות ומצברים',cx,y+r.h/2+46,{s:20,w:500,c:'#6B665C',a:'center'});
    m.days.forEach((d,i)=>{const x=dayX(i)+6,w=COL-12,cell=d.shifts.find(z=>z.sh===r.sh);
      imgRR(ctx,x,y,w,r.h,14);
      if(!cell){ctx.fillStyle='#ECE8E0';ctx.fill();T('—',x+w/2,y+r.h/2,{s:30,c:'#B8B2A5',a:'center'});return}
      ctx.fillStyle='#FFFFFF';ctx.fill();ctx.strokeStyle=col.c;ctx.globalAlpha=.35;ctx.lineWidth=2;ctx.stroke();ctx.globalAlpha=1;
      if(!cell.people.length){T('אין שיבוץ',x+w/2,y+r.h/2,{s:24,c:'#B04A3F',w:600,a:'center'});return}
      cell.people.forEach((p,j)=>{const cy=y+CPAD+j*LH+LH/2;let pw=0,lbl='';
        if(p.role){lbl=ROLESHORT[p.role];pw=MW(lbl,19,700)+22}
