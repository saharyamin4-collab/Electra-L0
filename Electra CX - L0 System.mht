  function calibState(){ const el=document.querySelector('#st1 [data-f="calib"]'); const v=el&&el.value; if(!v) return null; const left=Math.floor((new Date(v+'T23:59:59').getTime()-Date.now())/864e5); return left<0?{exp:true}:left<=14?{soon:left}:null; }
  function paintCalib(){ const w=$('calibWarn'), st=(cur&&cur.s1&&cur.s1.sig)?null:calibState(); w.hidden=!st; if(!st) return; w.className='fwarn'+(st.exp?'':' soon'); w.textContent=st.exp?'תוקף הכיול פג. יש להשתמש במד מומנט בתוקף.':(st.soon===0?'תוקף הכיול פג היום בסוף היום.':'תוקף הכיול יפוג בעוד '+st.soon+' ימים.'); }
