  document.addEventListener('change',e=>{ if(e.target.type==='checkbox'&&e.target.dataset.f){ queueSave('s'+e.target.closest('.stage').id.slice(2)); } });

  /* ---------- signature pad ---------- */
  function makePad(key){
    const host=document.querySelector('[data-sig="'+key+'"]');
    host.innerHTML='<div class="lbl"><span class="req">חתימה</span><button type="button" class="btn small">נקה</button></div><canvas class="pad" aria-label="משטח חתימה"></canvas>';
    const c=host.querySelector('canvas'),ctx=c.getContext('2d'); let drawing=false,dp=false,last=null;
