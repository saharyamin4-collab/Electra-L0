   נתיב בשרת: checklists/_shifts/  (נתיב שכבר פתוח לכתיבה באתר הצ'קליסטים, האתר הראשי מתעלם ממנו כי אין בו meta) */
(function(){
  if(window.claude&&typeof window.claude.use==='function')return;
  var CFG={apiKey:"AIzaSyCp_0vXHeobkLGEmZYDo60p1cqLLO1w5xw",authDomain:"electra-10.firebaseapp.com",
    databaseURL:"https://electra-10-default-rtdb.firebaseio.com",projectId:"electra-10",
    storageBucket:"electra-10.firebasestorage.app",messagingSenderId:"751223433308",
    appId:"1:751223433308:web:c07da01b36d20e7b3cde99"};
  var ROOT="checklists/_shifts/",fdb=null,identP=null,identV=null;
  function getDb(){
    if(!window.firebase)throw new Error("firebase sdk missing ("+location.protocol+" "+(navigator.onLine?"online":"offline")+")");
    if(!fdb){firebase.initializeApp(CFG);fdb=firebase.database();}
    return fdb;
  }
  /* כל מסמך נשמר כמחרוזת JSON אחת, כדי ש-Firebase לא ימחק מערכים ריקים או יהפוך אובייקטים למערכים */
  function enc(d){return{j:JSON.stringify(d),t:Date.now()};}
  function dec(v){if(!v||typeof v.j!=="string")return null;try{return JSON.parse(v.j);}catch(e){return null;}}
  function snap(id,val){var d=dec(val);return{id:id,exists:d!==null,data:function(){return d;}};}
  function limit(p,ms){return Promise.race([p,new Promise(function(_,rej){setTimeout(function(){rej({code:"timeout"});},ms);})]);}
  function docRef(path){
    var id=path.split("/").pop();
    function r(){return getDb().ref(ROOT+path);}
    return{
      set:function(d){return limit(r().set(enc(d)),10000);},
      delete:function(){return limit(r().remove(),10000);},
      get:function(){return r().once("value").then(function(s){return snap(id,s.val());});},
      onSnapshot:function(cb,err){
        var ref=r();
        var h=ref.on("value",function(s){cb(snap(id,s.val()));},function(e){if(err)err(e);});
        return function(){ref.off("value",h);};
      }
    };
  }
  function colRef(path){
    return{
    get:function(){return getDb().ref(ROOT+path).once("value").then(function(s){var docs=[];s.forEach(function(c){docs.push(snap(c.key,c.val()));});return{docs:docs};});},
    onSnapshot:function(cb,err){
      var ref=getDb().ref(ROOT+path);
      var h=ref.on("value",function(s){
        var docs=[];s.forEach(function(c){docs.push(snap(c.key,c.val()));});
        cb({docs:docs});
      },function(e){if(err)err(e);});
      return function(){ref.off("value",h);};
    }};
  }
  var db={doc:docRef,collection:colRef};

  /* זהות: השם שהמשתמש מזין. אותו שם בדיוק בכל מכשיר = אותן העדפות */
  function norm(n){return String(n||"").trim().replace(/\s+/g," ").toLowerCase();}
  function h32(s,salt){var h=5381;s=salt+s;for(var i=0;i<s.length;i++)h=((h<<5)+h+s.charCodeAt(i))|0;return Math.abs(h).toString(36);}
  function makeId(n){var k=norm(n);return"u"+h32(k,"a")+h32(k,"b");}
  function readIdent(){try{var v=JSON.parse(localStorage.getItem("cx_ident")||"null");if(v&&v.id&&v.name)return v;}catch(e){}return null;}
  function askIdent(){
    return new Promise(function(resolve){
      var bg=document.createElement("div");
      bg.style.cssText="position:fixed;inset:0;z-index:9999;background:rgba(14,27,41,.6);display:flex;align-items:center;justify-content:center;padding:20px";
      bg.innerHTML='<div class="card lock" style="margin:0;width:100%;max-width:380px">'+
        '<div class="ico" aria-hidden="true">👤</div><h2>מי אתה?</h2>'+
        '<p class="hint" style="margin:4px auto 12px">הזן את שמך כדי שההעדפות יישמרו בשרת ויופיעו גם במכשיר אחר. בכל מכשיר הזן את אותו שם בדיוק.</p>'+
        '<input class="in" id="cxid-name" placeholder="שם מלא" autocomplete="name">'+
        '<div style="margin-top:12px"><button class="btn" id="cxid-go" style="width:100%">המשך</button></div></div>';
      document.body.appendChild(bg);
      var inp=bg.querySelector("#cxid-name"),go=bg.querySelector("#cxid-go");
      function done(){
        var name=inp.value.trim().replace(/\s+/g," ");
        if(name.length<2){inp.focus();return;}
        var v={name:name,id:makeId(name)};
        try{localStorage.setItem("cx_ident",JSON.stringify(v));}catch(e){}
        bg.remove();resolve(v);
      }
      go.onclick=done;
      inp.onkeydown=function(e){if(e.key==="Enter")done();};
      setTimeout(function(){inp.focus();},50);
    });
  }
  function ident(){
    if(identV)return Promise.resolve(identV);
    var v=readIdent();
    if(v){identV=v;return Promise.resolve(v);}
    if(!identP)identP=askIdent().then(function(x){identV=x;return x;});
    return identP;
  }
  var user={
    id:function(){return ident().then(function(i){return i.id;});},
    me:function(){return ident().then(function(i){return{name:i.name,id:i.id};});},
    canEdit:function(){return Promise.resolve(true);}
  };
  window.__cxShim={name:function(){return identV?identV.name:"";}};
  window.claude={use:function(n){
    try{
      if(n==="db"){getDb();return Promise.resolve(db);}
      if(n==="user")return Promise.resolve(user);
    }catch(e){return Promise.reject(e);}
    return Promise.reject(new Error("unknown "+n));
  }};
})();
</script>
<script>
const ico=(n,c)=>`<svg class="ic${c?' '+c:''}" aria-hidden="true"><use href="#i-${n}"/></svg>`;
const initials=n=>{const p=String(n||'').trim().split(/\s+/).filter(Boolean);return p.length?(p[0][0]+(p[1]?p[1][0]:'')).toUpperCase():''};
const SHI={morning:'sun',afternoon:'sunset',evening:'moon'};
function applyTheme(){let t='auto';try{t=localStorage.getItem('cx_theme')||'auto'}catch(e){}const r=document.documentElement;if(t==='auto')r.removeAttribute('data-theme');else r.setAttribute('data-theme',t)}
applyTheme();
function openSheet(html,label){const sh=document.getElementById('sheet');sh.innerHTML=`<div class="sheet-bg" data-action="sheetClose"></div><div class="sheet" role="dialog" aria-modal="true" aria-label="${esc(label||'')}"><div class="grab"></div>${html}</div>`;const f=sh.querySelector('.sheet');if(f){f.setAttribute('tabindex','-1');f.style.outline='none';f.focus({preventScroll:true})}}
function closeSheet(){const sh=document.getElementById('sheet');if(sh)sh.innerHTML=''}
const SH=['morning','afternoon','evening'];
const SHL={morning:'בוקר',afternoon:'ערב',evening:'לילה'};
const SHC={morning:'ph-m',afternoon:'ph-a',evening:'ph-e'};
const DAYN=['ראשון','שני','שלישי','רביעי','חמישי','שישי','שבת'];
const DAYS=['א׳','ב׳','ג׳','ד׳','ה׳','ו׳','ש׳'];
const RANKW=['עדיפות 1','עדיפות 2','עדיפות 3'];
const ROLES=['insp','load','night'];
const ROLEFULL={insp:'בודק CX',load:'עומסים',night:'בודק CX'};
const ROLESHORT={insp:'בודק CX',load:'עומסים',night:'בודק CX'};
const ROLEC={insp:'r-i',load:'r-l',night:'r-i'};
const ROLEORD={insp:0,load:1,night:2};
const capsOf=p=>p&&Array.isArray(p.roles)&&p.roles.length?p.roles:['insp','load'];
const canDo=(p,r)=>r==='load'?capsOf(p).includes('load'):capsOf(p).includes('insp');

const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const ymd=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
const parseYmd=s=>{const [y,m,d]=String(s).split('-').map(Number);return new Date(y,(m||1)-1,d||1)};
const dm=d=>d.getDate()+'.'+(d.getMonth()+1);
const dayDiff=(a,b)=>Math.round((b-a)/864e5);
const clone=o=>JSON.parse(JSON.stringify(o));
function hash(s){let h=5381;for(let i=0;i<s.length;i++)h=((h<<5)+h+s.charCodeAt(i))|0;return Math.abs(h)}
function nextSunday(){const t=new Date();t.setHours(0,0,0,0);t.setDate(t.getDate()+((7-t.getDay())%7||7));return ymd(t)}
function defaults(){return{start:nextSunday(),days:[0,1,2,3,4,5],need:{morning:{insp:2,load:1,night:0},afternoon:{insp:1,load:1,night:0},evening:{insp:0,load:0,night:1}},hours:{morning:['08:00','17:00'],afternoon:['14:00','23:00'],evening:['23:00','07:00']},fri:{need:{insp:1,load:1,night:0},hours:['07:00','13:00']},deadline:'',rest:8}}
function normNeed(n,d){const o={};ROLES.forEach(r=>{const v=n?Number(n[r]):NaN;o[r]=Number.isFinite(v)?Math.max(0,Math.min(30,Math.round(v))):d[r]});return o}
function normSettings(s){const d=defaults();if(!s)return d;const need={};SH.forEach(sh=>{need[sh]=normNeed(s.need&&s.need[sh],d.need[sh])});return{start:s.start||d.start,days:Array.isArray(s.days)?s.days.slice():d.days,need,hours:{...d.hours,...(s.hours||{})},fri:{need:normNeed(s.fri&&s.fri.need,d.fri.need),hours:(s.fri&&Array.isArray(s.fri.hours))?s.fri.hours.slice():d.fri.hours},deadline:s.deadline||'',rest:Number.isFinite(s.rest)?Math.max(0,Math.min(16,Math.round(s.rest))):d.rest}}
function emptyPrefs(){return{name:'',roles:[],order:[],days:{},note:'',period:'',updatedAt:0}}
function normPrefs(p){const e=emptyPrefs();if(!p)return e;const r={name:p.name||'',order:Array.isArray(p.order)?p.order.filter(x=>SH.includes(x)):[],days:p.days&&typeof p.days==='object'?clone(p.days):{},note:p.note||'',period:p.period||'',updatedAt:p.updatedAt||0,complete:p.complete!==false,roles:Array.isArray(p.roles)?p.roles.filter((x,i,a)=>(x==='insp'||x==='load')&&a.indexOf(x)===i):[]};
  if(r.order.length===3){for(let w=0;w<7;w++){if(w===FRI)continue;const d=r.days[w]||{};if(!d.off&&!(Array.isArray(d.order)&&d.order.length===3)){d.order=r.order.slice();r.days[w]=d}}r.order=[]}
  return r}
function periodDays(s){const out=[],st=parseYmd(s.start);for(let i=0;i<7;i++){const d=new Date(st);d.setDate(st.getDate()+i);if(s.days.includes(d.getDay()))out.push({w:d.getDay(),date:d,key:ymd(d)})}return out}
function rangeLabel(s){const ds=periodDays(s);if(!ds.length)return'';return ds.length===1?dm(ds[0].date):dm(ds[0].date)+'–'+dm(ds[ds.length-1].date)}
const hrs=(s,sh)=>s.hours[sh][0]+'–'+s.hours[sh][1];
const FRI=5;
const dayShifts=w=>w===FRI?['morning']:SH;
const NONEED={insp:0,load:0,night:0};
const needOf=(s,w,sh)=>w===FRI?(sh==='morning'?s.fri.need:NONEED):s.need[sh];
const capOf=(s,w,sh)=>{const n=needOf(s,w,sh);return n.insp+n.load+n.night};
function slotRoles(s,w,sh){const n=needOf(s,w,sh),o=[];ROLES.forEach(r=>{for(let k=0;k<n[r];k++)o.push(r)});return o}
const hrsOf=(s,w,sh)=>w===FRI&&sh==='morning'?s.fri.hours[0]+'–'+s.fri.hours[1]:hrs(s,sh);
const isOff=(p,w)=>!!(p.days&&p.days[w]&&p.days[w].off);
function dayOrder(p,w){const d=p.days&&p.days[w];const need=w===FRI?1:3;if(d&&Array.isArray(d.order)&&d.order.length===need)return d.order;if(w!==FRI&&p.order&&p.order.length===3)return p.order;return null}
function dayDone(p,w){return isOff(p,w)||!!dayOrder(p,w)}
function missingDays(p){return periodDays(S.settings).filter(d=>!dayDone(p,d.w))}
function rankOf(p,w,sh){const o=dayOrder(p,w);return o?o.indexOf(sh):1}
function complete(p){return !!p.name.trim()&&(p.roles||[]).length>0&&missingDays(p).length===0}

/* ---------- scheduling engine: per-day optimal assignment (Hungarian) with weekly fairness ---------- */
function hungarian(a){const n=a.length,m=a[0].length,INF=1e15;const u=Array(n+1).fill(0),v=Array(m+1).fill(0),p=Array(m+1).fill(0),way=Array(m+1).fill(0);
  for(let i=1;i<=n;i++){p[0]=i;let j0=0;const minv=Array(m+1).fill(INF),used=Array(m+1).fill(false);
    do{used[j0]=true;const i0=p[j0];let delta=INF,j1=0;
      for(let j=1;j<=m;j++)if(!used[j]){const cur=a[i0-1][j-1]-u[i0]-v[j];if(cur<minv[j]){minv[j]=cur;way[j]=j0}if(minv[j]<delta){delta=minv[j];j1=j}}
      for(let j=0;j<=m;j++){if(used[j]){u[p[j]]+=delta;v[j]-=delta}else minv[j]-=delta}
      j0=j1}while(p[j0]!==0);
    do{const j1=way[j0];p[j0]=p[j1];j0=j1}while(j0)}
  const ans=Array(n);for(let j=1;j<=m;j++)if(p[j])ans[p[j]-1]=j-1;return ans}

/* ---------- rest between shifts ---------- */
const toMin=t=>{const [h,m]=String(t||'0:0').split(':').map(Number);return(h||0)*60+(m||0)};
function spanOf(s,key,w,sh){const [y,mo,d]=key.split('-').map(Number);const base=Date.UTC(y,mo-1,d)/60000;
  const hr=(w===FRI&&sh==='morning')?s.fri.hours:s.hours[sh];const a=toMin(hr[0]),b0=toMin(hr[1]);return{a:base+a,b:base+(b0<=a?b0+1440:b0)}}
const shiftLen=(s,w,sh)=>{const p=spanOf(s,'2026-01-05',w,sh);return(p.b-p.a)/60};
const numHe=n=>String(Math.round(n*10)/10);
const hoursHe=n=>n<0?'חפיפה בין המשמרות':n===0?'ללא מנוחה':n===1?'שעה אחת':numHe(n)+' שעות';
function restIssues(s,sc){const per={};
  Object.keys(sc.days||{}).sort().forEach(key=>{const w=parseYmd(key).getDay();dayShifts(w).forEach(sh=>(sc.days[key][sh]||[]).forEach(id=>{(per[id]=per[id]||[]).push({key,sh,w,...spanOf(s,key,w,sh)})}))});
  const out=[];Object.keys(per).forEach(id=>{const l=per[id].sort((x,y)=>x.a-y.a);for(let i=1;i<l.length;i++){const gap=(l[i].a-l[i-1].b)/60;if(gap<s.rest)out.push({id,name:(sc.people&&sc.people[id])||'?',prev:l[i-1],next:l[i],gap})}});
  return out}
const issueText=(i,s)=>`${i.name}: משמרת ${SHL[i.prev.sh]} (${DAYS[i.prev.w]} ${dm(parseYmd(i.prev.key))}) ואחריה משמרת ${SHL[i.next.sh]} (${DAYS[i.next.w]} ${dm(parseYmd(i.next.key))}). מנוחה בין המשמרות: ${hoursHe(i.gap)}. מינימום נדרש: ${hoursHe(s.rest)}.`;
const durSpan=(id,len)=>`<span class="dur num${len>10?' bad':''}" id="${id}">${numHe(len)} שעות${len>10?' · מעל 10':''}</span>`;
function setDur(e,len){e.textContent=numHe(len)+' שעות'+(len>10?' · מעל 10':'');e.classList.toggle('bad',len>10)}
function updDur(){const d=S.setDraft;if(!d)return;SH.forEach(sh=>{const e=document.getElementById('dur-'+sh);if(e)setDur(e,shiftLen(d,0,sh))});const f=document.getElementById('dur-fri');if(f)setDur(f,shiftLen(d,FRI,'morning'))}
const cntHe=(n,one,many)=>n===1?one:n+' '+many;
function healthHTML(sc){const s=S.settings,iss=restIssues(s,sc),short=shortages(s,sc);
  const longs=[...SH.map(sh=>[SHL[sh],shiftLen(s,0,sh)]),['שישי בוקר',shiftLen(s,FRI,'morning')]].filter(x=>x[1]>10);
  const row=(ok,t)=>`<li class="${ok?'':'bad'}"><span class="ci" aria-hidden="true">${ok?'✓':'✕'}</span><span>${t}</span></li>`;
  const hrs={};Object.keys(sc.days||{}).forEach(k=>{const w=parseYmd(k).getDay();dayShifts(w).forEach(sh=>(sc.days[k][sh]||[]).forEach(id=>{hrs[id]=(hrs[id]||0)+shiftLen(s,w,sh)}))});
  const list=Object.keys(hrs).sort((a,b)=>hrs[b]-hrs[a]),mx=Math.max(1,...list.map(id=>hrs[id]));
