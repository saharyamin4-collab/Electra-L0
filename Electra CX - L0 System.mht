<!doctype html>
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#F1F4F9" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#070D16" media="(prefers-color-scheme: dark)">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" type="image/png" href="icon-192.png">
<link rel="apple-touch-icon" href="icon-192.png">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>סידור משמרות CXelectra, בית שמש MDCIL4</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Hebrew:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
<style>
:root{
  --bg:#F1F4F9; --surface:#FFFFFF; --surface-2:#F0F3F9; --surface-3:#E4EAF3;
  --ink:#0A1626; --ink-2:#44536B; --ink-3:#73829A;
  --line:#DCE3EE; --line-2:#E8EDF5;
  --brand:#1546A0; --brand-2:#2F6BFF; --on-brand:#FFFFFF; --brand-soft:#E7EEFF;
  --ph-m:#D18A0B; --ph-a:#1D86C0; --ph-e:#6552D9;
  --ph-m-soft:#FDF2DA; --ph-a-soft:#E1F1FA; --ph-e-soft:#EDE9FE;
  --ok:#17935F; --mid:#73829A; --warn:#C0561A; --danger:#D02C42; --wa:#1FA855;
  --shadow-1:0 1px 2px rgba(10,22,38,.06);
  --shadow:0 1px 2px rgba(10,22,38,.05),0 12px 32px -16px rgba(10,22,38,.24);
  --shadow-up:0 -8px 36px -10px rgba(10,22,38,.30);
  --glass:rgba(255,255,255,.78);
  --r-s:12px; --r-m:16px; --r-l:22px; --r-xl:28px;
  --nav-h:76px;
  color-scheme:light;
  box-sizing:border-box;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#070D16; --surface:#0F1824; --surface-2:#152233; --surface-3:#1C2C42;
    --ink:#E8EEF7; --ink-2:#A9B6C8; --ink-3:#75849A;
    --line:#233449; --line-2:#1A2A40; --brand:#8DB7FF; --brand-2:#5C93FF; --on-brand:#06101E; --brand-soft:#15294B;
    --ph-m:#EBAA3C; --ph-a:#4DB0E2; --ph-e:#9285F2;
    --ph-m-soft:#2A2314; --ph-a-soft:#10283A; --ph-e-soft:#1D1A3A;
    --ok:#46C08A; --mid:#8C99A6; --warn:#E3844C; --danger:#F06A7A; --wa:#2BC165;
    --shadow-1:0 1px 2px rgba(0,0,0,.4);
    --shadow:0 1px 2px rgba(0,0,0,.35),0 14px 34px -16px rgba(0,0,0,.7);
    --shadow-up:0 -8px 36px -10px rgba(0,0,0,.7);
    --glass:rgba(15,24,36,.78);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#070D16; --surface:#0F1824; --surface-2:#152233; --surface-3:#1C2C42;
  --ink:#E8EEF7; --ink-2:#A9B6C8; --ink-3:#75849A;
  --line:#233449; --line-2:#1A2A40; --brand:#8DB7FF; --brand-2:#5C93FF; --on-brand:#06101E; --brand-soft:#15294B;
  --ph-m:#EBAA3C; --ph-a:#4DB0E2; --ph-e:#9285F2;
  --ph-m-soft:#2A2314; --ph-a-soft:#10283A; --ph-e-soft:#1D1A3A;
  --ok:#46C08A; --mid:#8C99A6; --warn:#E3844C; --danger:#F06A7A; --wa:#2BC165;
  --shadow-1:0 1px 2px rgba(0,0,0,.4);
  --shadow:0 1px 2px rgba(0,0,0,.35),0 14px 34px -16px rgba(0,0,0,.7);
  --shadow-up:0 -8px 36px -10px rgba(0,0,0,.7);
  --glass:rgba(15,24,36,.78);
  color-scheme:dark;
}
*,*::before,*::after{box-sizing:inherit}
html{background:var(--bg);-webkit-text-size-adjust:100%}
body{margin:0;color:var(--ink);font:16px/1.55 "IBM Plex Sans Hebrew",system-ui,-apple-system,"Segoe UI",Arial,sans-serif;-webkit-font-smoothing:antialiased;min-height:100vh;
  background:radial-gradient(900px 380px at 50% -140px,color-mix(in srgb,var(--brand-2) 13%,transparent),transparent),var(--bg);background-repeat:no-repeat}
button,input,textarea,select{font:inherit;color:inherit}
button{cursor:pointer;-webkit-tap-highlight-color:transparent}
:focus-visible{outline:2.5px solid var(--brand-2);outline-offset:2px;border-radius:10px}
.num{font-variant-numeric:tabular-nums}
.ic{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}
.ic.fill{fill:currentColor;stroke:none}
.ic.sm{width:16px;height:16px}.ic.lg{width:26px;height:26px}

/* ---------- app bar ---------- */
.top{position:sticky;top:0;z-index:20;background:var(--glass);-webkit-backdrop-filter:saturate(1.6) blur(18px);backdrop-filter:saturate(1.6) blur(18px);border-bottom:1px solid var(--line-2);padding-top:env(safe-area-inset-top,0px)}
.top-in{max-width:980px;margin:0 auto;padding:10px 16px;display:flex;align-items:center;gap:10px}
.brand{display:flex;align-items:center;gap:9px;min-width:0}
.mark{display:flex;gap:3px;align-items:flex-end;height:22px}
.mark i{display:block;width:5px;border-radius:2px}
.mark i:nth-child(1){height:22px;background:var(--ph-m)}
.mark i:nth-child(2){height:16px;background:var(--ph-a)}
.mark i:nth-child(3){height:10px;background:var(--ph-e)}
.word{font-weight:700;font-size:17px;letter-spacing:-.01em;direction:ltr}
.site{margin-inline-start:auto;display:inline-flex;align-items:center;gap:7px;padding:5px 11px;border-radius:999px;border:1px solid var(--line);background:var(--surface);font-size:13px;font-weight:600;white-space:nowrap}
.site .dot{width:7px;height:7px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 3px color-mix(in srgb,var(--ok) 22%,transparent)}
.site.off .dot{background:var(--warn);box-shadow:0 0 0 3px color-mix(in srgb,var(--warn) 22%,transparent)}
.avatar-btn{flex:none;width:38px;height:38px;border-radius:50%;border:0;display:grid;place-items:center;font-weight:700;font-size:14px;color:#fff;background:linear-gradient(135deg,var(--brand-2),#7B5CF0);box-shadow:0 6px 16px -8px var(--brand-2)}
.avatar-btn:active{transform:scale(.96)}

/* ---------- layout ---------- */
main{max-width:980px;margin:0 auto;padding:14px 16px calc(var(--nav-h) + 150px)}
main.enter>*{animation:rise .38s cubic-bezier(.2,.8,.3,1) both}
main.enter>*:nth-child(2){animation-delay:.04s}main.enter>*:nth-child(3){animation-delay:.08s}main.enter>*:nth-child(4){animation-delay:.12s}
@keyframes rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@keyframes fade{from{opacity:0}to{opacity:1}}
@keyframes slideup{from{transform:translateY(40px);opacity:0}to{transform:none;opacity:1}}

/* ---------- hero ---------- */
.hero{position:relative;overflow:hidden;border-radius:var(--r-xl);padding:20px 20px 18px;margin-bottom:16px;color:#fff;background:linear-gradient(135deg,#0C2444 0%,#13408A 58%,#2A62D6 100%);box-shadow:0 22px 44px -26px rgba(21,70,160,.8)}
.hero::before{content:"";position:absolute;inset:-60% auto auto -16%;width:380px;height:380px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.17),transparent 66%)}
.hero .deco{position:absolute;inset-inline-end:16px;bottom:0;display:flex;gap:7px;align-items:flex-end;opacity:.22}
.hero .deco i{display:block;width:16px;border-radius:6px 6px 0 0}
.hero .deco i:nth-child(1){height:78px;background:#EBAA3C}.hero .deco i:nth-child(2){height:54px;background:#4DB0E2}.hero .deco i:nth-child(3){height:32px;background:#9285F2}
.hero>*{position:relative}
.hero .eyebrow{font-size:13px;opacity:.82;letter-spacing:.02em;font-weight:500}
.hero h1{margin:4px 0 14px;font-size:34px;line-height:1.08;font-weight:700;letter-spacing:-.025em}
.hchips{display:flex;gap:6px;flex-wrap:wrap}
.hchip{display:inline-flex;align-items:center;gap:6px;padding:6px 10px 6px 9px;border-radius:999px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.2);font-size:13px;font-weight:500;white-space:nowrap;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
.hchip .ic{width:16px;height:16px}
.hchip.ok{background:rgba(40,200,125,.24);border-color:rgba(40,200,125,.5)}
.hchip.warn{background:rgba(255,176,64,.24);border-color:rgba(255,176,64,.55)}
.hchip.bad{background:rgba(255,90,110,.26);border-color:rgba(255,90,110,.55)}

/* ---------- cards & text ---------- */
.card{background:var(--surface);border:1px solid var(--line-2);border-radius:var(--r-l);padding:18px;box-shadow:var(--shadow);margin-bottom:14px}
.card h2{margin:0 0 4px;font-size:18px;font-weight:600;letter-spacing:-.01em}
.card-h{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.card-h h2{margin:0}.card-h .hint{margin:0}
.ibadge{flex:none;width:40px;height:40px;border-radius:13px;display:grid;place-items:center;background:var(--brand-soft);color:var(--brand)}
.ibadge.ph-m,.ibadge.ph-a,.ibadge.ph-e{background:var(--soft);color:var(--ph)}
.hint{margin:0 0 14px;color:var(--ink-2);font-size:14.5px;max-width:64ch}
.banner{display:flex;gap:10px;align-items:flex-start;padding:12px 14px;border-radius:var(--r-m);background:var(--surface);border:1px solid var(--line);color:var(--ink-2);font-size:14.5px;margin-bottom:14px;box-shadow:var(--shadow-1)}
.banner b{color:var(--ink)}
.banner.warn{border-color:color-mix(in srgb,var(--warn) 45%,var(--line));background:color-mix(in srgb,var(--warn) 10%,var(--surface))}
.link{background:none;border:0;padding:4px 2px;color:var(--brand);font-weight:600;text-decoration:underline;text-underline-offset:3px}

/* ---------- fields ---------- */
label.lbl{display:block;font-size:13.5px;font-weight:600;color:var(--ink-2);margin-bottom:7px}
.in{box-sizing:border-box;width:100%;min-width:0;padding:13px 14px;border-radius:14px;border:1.5px solid var(--line);background:var(--surface-2);transition:border-color .15s,box-shadow .15s,background .15s}
.in:focus{outline:none;border-color:var(--brand-2);background:var(--surface);box-shadow:0 0 0 4px color-mix(in srgb,var(--brand-2) 18%,transparent)}
textarea.in{min-height:84px;resize:vertical}
input[type=date].in,input[type=time].in{max-width:100%}
.row2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.namecard{display:flex;align-items:center;gap:14px}
.namecard .av-lg{flex:none;width:52px;height:52px;border-radius:50%;display:grid;place-items:center;font-size:19px;font-weight:700;color:#fff;background:linear-gradient(135deg,var(--brand-2),#7B5CF0)}
.namecard>div{flex:1;min-width:0}
.seg{display:flex;padding:4px;gap:4px;border-radius:16px;background:var(--surface-2);border:1px solid var(--line-2)}
.seg button{flex:1;display:flex;align-items:center;justify-content:center;gap:7px;padding:11px 8px;border:0;border-radius:12px;background:transparent;font-weight:600;font-size:14.5px;color:var(--ink-2);transition:background .18s,color .18s,box-shadow .18s}
.seg button[aria-pressed="true"],.seg button[aria-selected="true"]{background:var(--surface);color:var(--ink);box-shadow:var(--shadow-1),0 0 0 1px var(--line)}
.seg button[aria-pressed="true"] .ic{color:var(--brand-2)}

/* ---------- ranking tiles ---------- */
.tiles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.tile{position:relative;overflow:hidden;text-align:center;background:var(--surface-2);border:1.5px solid transparent;border-radius:var(--r-m);padding:14px 8px 12px;min-height:118px;display:flex;flex-direction:column;align-items:center;gap:3px;transition:border-color .2s,background .2s,transform .12s,box-shadow .25s}
.tile:active{transform:scale(.97)}
.tile .rail{display:none}
.tile .ti{width:36px;height:36px;border-radius:12px;display:grid;place-items:center;background:var(--soft);color:var(--ph);margin-bottom:2px}
.tile .nm{font-weight:600;font-size:16px;line-height:1.2}
.tile .hr{color:var(--ink-3);font-size:12px;direction:ltr;white-space:nowrap}
.tile .rk{margin-top:auto;width:30px;height:30px;border-radius:50%;border:2px dashed var(--line);display:grid;place-items:center;font-weight:700;font-size:15px;color:transparent;transition:all .25s}
.tile[aria-pressed="true"]{background:var(--soft);border-color:var(--ph);box-shadow:0 10px 24px -16px var(--ph)}
.tile[aria-pressed="true"] .rk{border:0;background:var(--ph);color:#fff;transform:scale(1.06)}
.tile.next .rk{border-color:var(--ph);color:var(--ph)}
.tile.sm{min-height:112px}
.tiles-foot{display:flex;justify-content:space-between;align-items:center;margin-top:10px;font-size:13.5px;color:var(--ink-3)}
.tiles.one{grid-template-columns:1fr}
.tiles.one .tile{min-height:68px;flex-direction:row;align-items:center;gap:12px;padding:14px 16px;text-align:start}
.tiles.one .tile .ti{margin:0}
.tiles.one .tile .hr{margin-inline-start:4px}
.tiles.one .tile .rk{margin:0;margin-inline-start:auto}

/* ---------- prefs day blocks ---------- */
.prog{display:flex;gap:5px;margin:4px 0 8px}
.prog span{flex:1;height:8px;border-radius:4px;background:var(--surface-3);transition:background .3s}
.prog span.done{background:linear-gradient(90deg,var(--ok),color-mix(in srgb,var(--ok) 70%,#7CE0B0))}
.progl{font-size:13.5px;color:var(--ink-3);margin-bottom:4px}
.dayblock{padding:14px;border:1px solid var(--line-2);border-radius:var(--r-m);margin-top:12px;background:var(--surface)}
.dayhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.dname{font-weight:600}
.dname small{color:var(--ink-3);font-weight:400;font-size:13px;margin-inline-start:4px}
.dayhead .dname{font-size:17px}
.dacts{display:flex;gap:8px;align-items:center}
.dstat{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:var(--ok);color:#fff;font-size:14px;font-weight:700}
.btn-s{border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:7px 13px;font-size:13.5px;font-weight:600;color:var(--ink-2)}
.btn-s[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.offtag{color:var(--ink-3);font-size:14px;margin:0}
.pills{display:flex;gap:6px;flex-wrap:wrap}
.pill{display:inline-flex;align-items:center;gap:6px;padding:4px 11px 4px 8px;border-radius:999px;background:var(--soft);font-size:13.5px;font-weight:600;border:1px solid color-mix(in srgb,var(--ph) 30%,transparent)}
.pill i{font-style:normal;width:18px;height:18px;border-radius:50%;background:var(--ph);color:#fff;font-size:11.5px;display:grid;place-items:center;font-weight:700}
.sumrow{display:grid;grid-template-columns:84px minmax(0,1fr);gap:8px;align-items:center;padding:11px 0;border-top:1px solid var(--line-2)}
.sumrow .pills{flex-wrap:nowrap;gap:5px}
.sumrow .pill{font-size:12.5px;padding:4px 9px 4px 6px;gap:4px}
.sumnote{margin-top:12px;padding:11px 13px;border-radius:var(--r-s);background:var(--surface-2);font-size:14.5px;color:var(--ink-2)}
.saved{border-color:color-mix(in srgb,var(--ok) 40%,var(--line))}
.savedhead{display:flex;gap:14px;align-items:flex-start;margin-bottom:12px}
.bigok{flex:none;width:46px;height:46px;border-radius:50%;background:var(--ok);color:#fff;display:grid;place-items:center;font-size:22px;font-weight:700;box-shadow:0 10px 22px -10px var(--ok)}
.restore{margin-top:18px;text-align:center}
.restore textarea,.restore .btns{text-align:start}
.restore .btns{justify-content:center}

/* ---------- buttons ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:15px;padding:13px 20px;font-weight:600;font-size:16px;background:var(--brand);color:var(--on-brand);transition:filter .15s,transform .1s,box-shadow .2s;box-shadow:0 10px 22px -14px var(--brand)}
.btn:hover{filter:brightness(1.07)}
.btn:active{transform:translateY(1px) scale(.99)}
.btn:disabled{opacity:.45;cursor:not-allowed;box-shadow:none}
.btn.ghost{background:var(--surface);color:var(--ink);border:1.5px solid var(--line);box-shadow:none}
.btn.tonal{background:var(--brand-soft);color:var(--brand);box-shadow:none}
.btn.wa{background:var(--wa);color:#fff;box-shadow:0 10px 22px -12px var(--wa)}
.btn.sm{padding:9px 14px;font-size:14px;border-radius:12px}
.btns{display:flex;gap:10px;flex-wrap:wrap}

/* ---------- floating save bar & bottom nav ---------- */
.savebar{position:fixed;inset:auto 0 calc(var(--nav-h) + env(safe-area-inset-bottom,0px) + 8px);z-index:18;padding:0 14px;pointer-events:none}
.savebar-in{pointer-events:auto;max-width:560px;margin:0 auto;display:flex;align-items:center;gap:12px;padding:9px 9px 9px 14px;border-radius:22px;background:var(--glass);-webkit-backdrop-filter:saturate(1.6) blur(18px);backdrop-filter:saturate(1.6) blur(18px);border:1px solid var(--line);box-shadow:var(--shadow-up)}
.savebar .st{font-size:13.5px;color:var(--ink-2);flex:1;line-height:1.35}
.savebar .st.dirty{color:var(--warn);font-weight:600}
.savebar .btn{padding:12px 18px;font-size:15px}
.nav{position:fixed;inset:auto 0 0;z-index:25;padding:0 14px calc(10px + env(safe-area-inset-bottom,0px));pointer-events:none}
.nav-in{pointer-events:auto;max-width:480px;margin:0 auto;display:flex;gap:4px;padding:6px;border-radius:26px;background:var(--glass);-webkit-backdrop-filter:saturate(1.6) blur(20px);backdrop-filter:saturate(1.6) blur(20px);border:1px solid var(--line);box-shadow:var(--shadow-up)}
.nb{flex:1;position:relative;display:flex;flex-direction:column;align-items:center;gap:3px;padding:9px 6px 8px;border:0;border-radius:20px;background:transparent;color:var(--ink-3);font-size:12px;font-weight:600;transition:background .2s,color .2s}
.nb .ic{width:23px;height:23px}
.nb[aria-selected="true"]{color:var(--brand);background:var(--brand-soft)}
.nb .nbadge{position:absolute;top:5px;inset-inline-end:calc(50% - 24px);min-width:18px;height:18px;padding:0 5px;border-radius:9px;background:var(--danger);color:#fff;font-size:11px;font-weight:700;display:grid;place-items:center}
.nb .nl{display:inline-flex;align-items:center;gap:4px}.nb .nl .ic{width:12px;height:12px;color:var(--ink-3)}

/* ---------- schedule ---------- */
.nextcard{display:flex;align-items:center;gap:14px;padding:16px;border-radius:var(--r-l);background:var(--soft);border:1px solid color-mix(in srgb,var(--ph) 38%,transparent);margin-bottom:14px}
.nextcard .nx-ic{flex:none;width:52px;height:52px;border-radius:17px;display:grid;place-items:center;background:var(--ph);color:#fff;box-shadow:0 12px 24px -12px var(--ph)}
.nextcard .nx-ic .ic{width:27px;height:27px}
.nextcard small{display:block;color:var(--ink-2);font-size:12.5px;font-weight:600;letter-spacing:.02em}
.nextcard b{display:block;font-size:20px;line-height:1.2;letter-spacing:-.01em}
.nextcard span.m{display:block;color:var(--ink-2);font-size:14px;margin-top:2px}
.sec-h{display:flex;align-items:center;justify-content:space-between;margin:18px 2px 10px}
.sec-h h2{margin:0;font-size:17px;font-weight:600}
.sec-h small{color:var(--ink-3);font-size:13px}
.mine{display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x proximity;padding:2px 2px 12px;margin:0 -2px;scrollbar-width:none}
.mine::-webkit-scrollbar{display:none}
.mineday{flex:0 0 122px;scroll-snap-align:start;border-radius:var(--r-m);padding:12px;background:var(--soft,var(--surface-2));border:1px solid color-mix(in srgb,var(--ph,var(--line)) 28%,var(--line-2))}
.mineday .d{font-size:12.5px;color:var(--ink-2);font-weight:600}
.mineday .mi{display:flex;align-items:center;gap:7px;margin:6px 0 3px;color:var(--ph,var(--ink-3))}
.mineday .s{font-weight:700;font-size:16px;color:var(--ink)}
.mineday .h{font-size:12.5px;color:var(--ink-3);direction:ltr;text-align:end}
.mineday.off{background:var(--surface);border-style:dashed}
.actbar{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:14px}
.act{display:flex;flex-direction:column;align-items:center;gap:6px;padding:13px 6px;border-radius:var(--r-m);border:1px solid var(--line-2);background:var(--surface);box-shadow:var(--shadow-1);font-size:13px;font-weight:600;color:var(--ink)}
.act .ic{width:22px;height:22px;color:var(--brand-2)}
.act.wa .ic{color:var(--wa)}
.act:active{transform:scale(.97)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px}
.day{background:var(--surface);border:1px solid var(--line-2);border-radius:var(--r-l);padding:14px;box-shadow:var(--shadow)}
.day.today{border-color:var(--brand-2);box-shadow:0 0 0 3px color-mix(in srgb,var(--brand-2) 16%,transparent),var(--shadow)}
.day-h{display:flex;justify-content:space-between;align-items:center;margin-bottom:2px}
.day-h b{font-size:18px;letter-spacing:-.01em}
.day-h .dpill{display:inline-flex;align-items:center;gap:6px;color:var(--ink-3);font-size:13px;font-weight:600}
.today-tag{padding:2px 8px;border-radius:999px;background:var(--brand-2);color:#fff;font-size:11.5px;font-weight:700}
.shift{margin-top:10px;padding:10px 11px 11px;border-radius:var(--r-m);background:var(--soft,var(--surface-2));border:1px solid color-mix(in srgb,var(--ph,var(--line)) 22%,var(--line-2))}
.shift-h{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.shift-h .si{flex:none;width:26px;height:26px;border-radius:9px;display:grid;place-items:center;background:var(--ph);color:#fff}
.shift-h .si .ic{width:15px;height:15px}
.shift-h b{font-weight:700;font-size:14.5px}
.shift-h .hh{color:var(--ink-3);font-size:12.5px;direction:ltr}
.shift-h .cap{margin-inline-start:auto;color:var(--ink-3);font-size:12.5px;font-weight:600}
.shift-h .cap.short{color:var(--danger)}
.chips{display:grid;gap:6px;min-height:28px}
.chip{display:flex;align-items:center;gap:9px;width:100%;padding:6px 10px 6px 9px;border-radius:13px;background:var(--surface);border:1px solid var(--line-2);font-size:14.5px;font-weight:600;text-align:start;box-shadow:var(--shadow-1)}
button.chip{transition:transform .1s,border-color .15s}
button.chip:hover{border-color:var(--ink-3)}
button.chip:active{transform:scale(.985)}
.chip .av{flex:none;width:28px;height:28px;border-radius:50%;display:grid;place-items:center;font-size:11.5px;font-weight:700;color:#fff;background:var(--avc,var(--mid))}
.chip .av.r-i{--avc:#2F6FB5}.chip .av.r-l{--avc:#C8741A}.chip .av.r-n{--avc:#2F6FB5}
.chip .cn{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chip .r{flex:none;width:19px;height:19px;border-radius:50%;display:grid;place-items:center;font-size:11px;font-weight:700;color:#fff;background:var(--mid)}
.chip .r.r0{background:var(--ok)}.chip .r.r2{background:var(--warn)}
.chip.me{background:var(--brand);color:var(--on-brand);border-color:var(--brand)}
.chip.me .av{background:rgba(255,255,255,.22)}
.chip.sel{outline:2.5px solid var(--brand-2);outline-offset:1px}
.empty-slot{font-size:13px;color:var(--ink-3);padding:5px 2px}
.bench{margin-top:12px;font-size:13px;color:var(--ink-3)}
.bench .chips{margin-top:6px}
.rt{display:inline-block;font-size:11.5px;font-weight:700;padding:2px 8px;border-radius:7px;color:#fff;background:var(--mid);white-space:nowrap}
.rt.r-i{background:#2F6FB5}.rt.r-l{background:#C8741A}.rt.r-n{background:#6B4FC0}
.chip.me .rt{box-shadow:0 0 0 1px rgba(255,255,255,.5)}
.miss{font-size:12.5px;color:var(--danger);font-weight:700;margin-top:6px}
.chip.warn{border-color:var(--danger);background:color-mix(in srgb,var(--danger) 10%,var(--surface));color:var(--danger)}
.chip .wi{font-size:13px;line-height:1}

/* ---------- stats ---------- */
.fold{padding:0;overflow:hidden}
.fold>summary{list-style:none;display:flex;align-items:center;gap:12px;padding:16px 18px;cursor:pointer;font-weight:600}
.fold>summary::-webkit-details-marker{display:none}
.fold>summary .ic.chev{margin-inline-start:auto;transition:transform .2s;color:var(--ink-3)}
.fold[open]>summary .ic.chev{transform:rotate(180deg)}
.fold .fold-b{padding:0 18px 18px}
.dist{display:flex;height:12px;border-radius:6px;overflow:hidden;background:var(--surface-3);margin:12px 0 10px}
.dist span{display:block;height:100%}
.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:14px;color:var(--ink-2)}
.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-inline-end:6px;vertical-align:middle}
.bignum{font-size:34px;font-weight:700;letter-spacing:-.02em;line-height:1}
.statgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:6px}
.statgrid div small{display:block;color:var(--ink-3);font-size:13px;margin-top:4px}

/* ---------- admin ---------- */
.kpis{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:14px}
.kpi{padding:14px 12px;border-radius:var(--r-m);background:var(--surface);border:1px solid var(--line-2);box-shadow:var(--shadow-1)}
.kpi b{display:block;font-size:28px;line-height:1.05;font-weight:700;letter-spacing:-.02em}
.kpi small{display:block;margin-top:4px;color:var(--ink-3);font-size:12.5px;font-weight:600}
.kpi.ok b{color:var(--ok)}.kpi.bad b{color:var(--danger)}
.acc{padding:0;overflow:hidden}
.acc-h{width:100%;display:flex;align-items:center;gap:12px;padding:16px 18px;border:0;background:transparent;text-align:start}
.acc-h .acc-t{flex:1;min-width:0}
.acc-h .acc-t b{display:block;font-size:17px;font-weight:600}
.acc-h .acc-t small{display:block;color:var(--ink-3);font-size:13px;margin-top:1px}
.acc-h .chev{color:var(--ink-3);transition:transform .2s}
.acc.open .acc-h .chev{transform:rotate(180deg)}
.acc-b{padding:0 18px 18px}
.acc:not(.open) .acc-b{display:none}
.daypick{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:7px}
.daypick button{width:100%;height:46px;border-radius:14px;border:1.5px solid var(--line);background:var(--surface);font-weight:700;color:var(--ink-2)}
.daypick button[aria-pressed="true"]{background:var(--brand);color:var(--on-brand);border-color:var(--brand);box-shadow:0 8px 18px -10px var(--brand)}
.shcfg{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px 12px;align-items:center;padding:14px 0;border-top:1px solid var(--line-2)}
.shcfg .nm{grid-row:1;grid-column:1}.shcfg .dur{grid-row:1;grid-column:2}.shcfg .times{grid-row:2;grid-column:1/-1}.shcfg .rcfg{grid-row:3}
.shcfg .nm{font-weight:700;display:flex;align-items:center;gap:8px}
.shcfg .nm::before{content:"";width:10px;height:24px;border-radius:4px;background:var(--ph)}
.times{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);gap:8px;align-items:center;direction:ltr}
.times input{width:100%;padding:10px 12px}
.stepper{display:inline-flex;align-items:center;border:1.5px solid var(--line);border-radius:13px;overflow:hidden;background:var(--surface)}
.stepper button{width:38px;height:40px;border:0;background:var(--surface-2);font-size:19px;font-weight:600}
.stepper span{min-width:36px;text-align:center;font-weight:700}
.rcfg{grid-column:1/-1;display:flex;gap:16px;flex-wrap:wrap}
.rcfg .rc{flex:1 1 100%;display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:14px;color:var(--ink-2);font-weight:500}
.restcfg{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:14px;padding:13px 14px;border-radius:var(--r-m);background:var(--surface-2)}
.restcfg .hint{font-size:13.5px}
.dur{font-size:12.5px;color:var(--ink-3);white-space:nowrap}.dur.bad{color:var(--danger);font-weight:700}
.team{display:flex;flex-direction:column}
.trow{display:grid;grid-template-columns:1fr auto;gap:8px;padding:12px 0;border-top:1px solid var(--line-2);align-items:center}
.trow:first-child{border-top:0}
.trow .who{font-weight:600;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.trow .meta{font-size:13px;color:var(--ink-3)}
.trow .note{grid-column:1/-1;font-size:13.5px;color:var(--ink-2);background:var(--surface-2);padding:8px 11px;border-radius:var(--r-s)}
.tag{font-size:12px;padding:2px 8px;border-radius:7px;background:color-mix(in srgb,var(--warn) 14%,transparent);color:var(--warn);font-weight:600}
.fc{display:flex;gap:5px}
.fc span{display:inline-flex;flex-direction:column;align-items:center;gap:2px;font-size:11.5px;color:var(--ink-3)}
.fc b{display:block;width:16px;height:16px;border-radius:5px;background:var(--ph,var(--line))}
.lockbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;font-size:14px;color:var(--ink-3)}
.lock{max-width:400px;margin:18px auto;text-align:center;padding:26px 22px}
.lock .ico{width:64px;height:64px;margin:0 auto 12px;border-radius:22px;display:grid;place-items:center;background:var(--brand-soft);color:var(--brand)}
.lock .ico .ic{width:30px;height:30px}
.pin{font-size:30px;letter-spacing:.5em;text-align:center;direction:ltr;padding:12px 10px 12px calc(10px + .5em);margin:6px 0 12px}
.pin.bad{border-color:var(--danger);animation:shake .35s}
@keyframes shake{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
.alertcard{border-color:var(--danger);background:color-mix(in srgb,var(--danger) 7%,var(--surface))}
.alertcard h2{color:var(--danger)}
.issue{display:flex;gap:10px;padding:10px 0;border-top:1px solid color-mix(in srgb,var(--danger) 25%,var(--line));font-size:14.5px;color:var(--ink)}
.issue>span:first-child{color:var(--danger);flex:none}
.hc{list-style:none;margin:10px 0 0;padding:0;display:grid;gap:10px}
.hc li{display:flex;gap:10px;align-items:flex-start;font-size:14.5px}
.hc .ci{flex:none;width:22px;height:22px;border-radius:50%;display:grid;place-items:center;font-size:13px;font-weight:700;color:#fff;background:var(--ok)}
.hc li.bad{color:var(--danger);font-weight:600}.hc li.bad .ci{background:var(--danger)}
.subh{margin:18px 0 8px;font-size:14px;color:var(--ink-2);font-weight:600}
.hrs{display:grid;gap:9px}
.hrs>div{display:grid;grid-template-columns:minmax(84px,1fr) 2fr auto;gap:10px;align-items:center;font-size:14px}
.hrs .trk{display:block;height:9px;border-radius:5px;background:var(--surface-3);overflow:hidden}
.hrs .trk i{display:block;height:100%;border-radius:5px;background:linear-gradient(90deg,var(--brand-2),#7B5CF0)}

/* ---------- sheets, toasts, modal ---------- */
.sheet-bg{position:fixed;inset:0;z-index:40;background:rgba(4,10,20,.52);-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px);animation:fade .2s both}
.sheet{position:fixed;inset:auto 0 0;z-index:41;max-width:560px;margin:0 auto;max-height:92vh;overflow:auto;border-radius:var(--r-xl) var(--r-xl) 0 0;background:var(--surface);padding:10px 18px calc(20px + env(safe-area-inset-bottom,0px));box-shadow:var(--shadow-up);animation:slideup .3s cubic-bezier(.2,.9,.3,1) both}
.sheet .grab{width:44px;height:5px;border-radius:3px;background:var(--line);margin:0 auto 14px}
.sheet h3{margin:0 0 4px;font-size:19px;font-weight:600}
.opt{display:flex;align-items:center;gap:12px;width:100%;padding:13px 14px;border-radius:var(--r-m);border:1.5px solid var(--line-2);background:var(--surface-2);margin-top:9px;text-align:start;transition:transform .1s,border-color .15s}
.opt:active{transform:scale(.985)}
.opt:hover{border-color:var(--brand-2)}
.opt .oi{flex:none;width:40px;height:40px;border-radius:13px;display:grid;place-items:center;background:var(--soft,var(--surface-3));color:var(--ph,var(--ink-2))}
.opt .ot{flex:1;min-width:0}
.opt .ot b{display:block;font-size:16px}
.opt .ot small{display:block;color:var(--ink-3);font-size:13px;direction:ltr;text-align:start}
.opt.bad{border-color:color-mix(in srgb,var(--danger) 55%,var(--line));background:color-mix(in srgb,var(--danger) 7%,var(--surface))}
.opt .why{color:var(--danger);font-size:12.5px;font-weight:700;display:flex;flex-direction:column;align-items:flex-end;line-height:1.3}.opt .why span{display:flex;align-items:center;gap:4px}.opt .why small{font-weight:500;opacity:.85}
.toast{position:fixed;left:50%;bottom:calc(var(--nav-h) + env(safe-area-inset-bottom,0px) + 20px);transform:translate(-50%,16px);background:var(--ink);color:var(--bg);padding:11px 18px;border-radius:16px;font-size:14.5px;font-weight:500;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;z-index:50;max-width:calc(100% - 32px);text-align:center;box-shadow:0 14px 34px -14px rgba(0,0,0,.5)}
.toast.on{opacity:1;transform:translate(-50%,0)}
.snack{position:fixed;left:50%;bottom:calc(var(--nav-h) + env(safe-area-inset-bottom,0px) + 20px);transform:translate(-50%,24px);z-index:50;display:flex;align-items:center;gap:14px;max-width:min(92vw,520px);padding:10px 8px 10px 18px;border-radius:16px;background:var(--ink);color:var(--bg);font-size:14.5px;box-shadow:0 14px 34px -14px rgba(0,0,0,.5);opacity:0;pointer-events:none;transition:opacity .2s,transform .2s}
.snack.on{opacity:1;transform:translate(-50%,0);pointer-events:auto}
.snack.warn{background:#B42335;color:#fff}
.snack button{flex:none;background:none;border:0;color:inherit;font-weight:700;text-decoration:underline;padding:8px 10px;min-height:40px}
.modal{position:fixed;inset:0;background:rgba(5,12,20,.5);display:grid;place-items:center;z-index:45;padding:20px}
.modal .card{width:min(560px,100%);margin:0}
.skel{height:120px;border-radius:var(--r-l);background:linear-gradient(90deg,var(--surface) 0,var(--surface-2) 50%,var(--surface) 100%);background-size:200% 100%;animation:sk 1.2s infinite linear;margin-bottom:12px}
@keyframes sk{to{background-position:-200% 0}}
.emptystate{text-align:center;padding:40px 20px;color:var(--ink-2)}
.emptystate .mark{justify-content:center;height:34px;margin-bottom:14px}
.emptystate .mark i{width:8px}
.emptystate .mark i:nth-child(1){height:34px}.emptystate .mark i:nth-child(2){height:24px}.emptystate .mark i:nth-child(3){height:14px}
.emptystate h3{margin:0 0 6px;color:var(--ink);font-size:19px}
.ph-m{--ph:var(--ph-m);--soft:var(--ph-m-soft)}
.ph-a{--ph:var(--ph-a);--soft:var(--ph-a-soft)}
.ph-e{--ph:var(--ph-e);--soft:var(--ph-e-soft)}
.imgwrap{border-radius:var(--r-m);overflow:hidden;border:1px solid var(--line);background:#fff;margin:12px 0}
.imgwrap img{display:block;width:100%;height:auto}
.agrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.agrid .btn{width:100%;padding:13px 10px;font-size:14.5px}
.agrid .full{grid-column:1/-1}
.diag{color:var(--ink-3);font-size:12px;margin:12px 0 0;text-align:center}
.icon-btn{width:40px;height:40px;border-radius:12px;border:0;background:var(--surface-2);display:grid;place-items:center;color:var(--ink-2)}
.sheet-h{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}
.sheet-h h3{margin:0}
#imgmodal.shot .sheet-bg{background:#000;-webkit-backdrop-filter:none;backdrop-filter:none}
#imgmodal.shot .imgbar{display:none!important}
#imgmodal.shot .sheet{inset:0;max-width:none;max-height:none;padding:0;border-radius:0;background:#000;box-shadow:none;animation:none;display:flex;align-items:center}
#imgmodal.shot .imgwrap{margin:0;border:0;border-radius:0;width:100%}
.twho{display:flex;align-items:center;gap:12px;min-width:0}
.tav{flex:none;width:40px;height:40px;border-radius:50%;display:grid;place-items:center;font-weight:700;font-size:14px;color:#fff;background:#2F6FB5}
.tav.r-l{background:#C8741A}.tav.r-b{background:#6B4FC0}.tav.r-x{background:var(--mid)}
.hero .deco{top:16px;bottom:auto;height:64px}
.hero .deco i:nth-child(1){height:64px}.hero .deco i:nth-child(2){height:44px}.hero .deco i:nth-child(3){height:26px}
.ltr{direction:ltr;unicode-bidi:isolate}
.in.ltr{direction:ltr;text-align:left}
.pushbox{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:var(--r-m);background:var(--surface-2);border:1px solid var(--line-2)}
.pushbox .pt{flex:1;font-size:13.5px;color:var(--ink-2);line-height:1.4}
.pushbox .pt b{display:block;color:var(--ink);font-size:15px}
.instbox{margin-top:12px}
.instbox .hint{margin:8px 2px 0;font-size:13px}
.why-no{margin-top:10px;padding:10px 12px;border-radius:var(--r-s);background:color-mix(in srgb,var(--warn) 10%,var(--surface));border:1px solid color-mix(in srgb,var(--warn) 40%,var(--line));font-size:13px;line-height:1.5;color:var(--ink-2)}
.why-no b{color:var(--ink)}
.nb .ndot{position:absolute;top:7px;inset-inline-end:calc(50% - 20px);width:10px;height:10px;border-radius:50%;background:var(--danger);box-shadow:0 0 0 2px var(--surface)}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
@media (min-width:860px){.hero{padding:26px 28px 24px}.hero h1{font-size:40px}.kpi b{font-size:32px}}
@media (max-width:380px){.hero h1{font-size:30px}.tile .nm{font-size:15px}.nb{font-size:11.5px}}
@media print{.top,.nav,.savebar,.toast,.snack,.lockbar,.btns,.actbar,.sheet,.sheet-bg,#imgmodal{display:none!important}body{background:#fff}.card,.day{box-shadow:none;break-inside:avoid}}
</style>
</head>
