    return`<button class="tile ${SHC[sh]} ${small?'sm':''} ${!on&&next<shs.length?'next':''}" data-action="rank" data-shift="${sh}" data-day="${w}" aria-pressed="${on}" aria-label="${SHL[sh]} ${one?(on?'זמין':'לא נבחר'):(on?RANKW[i]:'ללא דירוג')}">
      <span class="rail"></span><span class="ti">${ico(SHI[sh])}</span><span class="nm">${SHL[sh]}${one?' בלבד':''}</span><span class="hr num">${hrsOf(s,w,sh)}</span>
      <span class="rk num">${one?(on?'✓':''):(on?i+1:(next<3?next+1:''))}</span></button>`}).join('')}</div>`}

function pillsHTML(order,custom){return`<div class="pills">${order.map((sh,i)=>`<span class="pill ${SHC[sh]} ${custom?'custom':''}"><i class="num">${i+1}</i>${SHL[sh]}</span>`).join('')}</div>`}

function viewPrefs(){
  const s=S.settings,p=S.me,ds=periodDays(s);
  let h='';
  if(S.mode==='local')h+=`<div class="banner"><span>📄</span><span><b>מצב קובץ.</b> ההעדפות נשמרות במכשיר הזה בלבד. אחרי השמירה לחץ על <b>העתק קוד למנהל</b> ושלח לו את הקוד בוואטסאפ או במייל.</span></div>`;
  if(p.updatedAt&&p.period&&p.period!==s.start)h+=`<div class="banner warn"><span>⚡</span><span><b>נפתח שבוע חדש.</b> ההעדפות שלך הן מהשבוע הקודם. בדוק אותן ושמור שוב.</span></div>`;
  if(summaryMode())return h+summaryHTML(p,ds);
  h+=`<section class="card"><div class="namecard"><span class="av-lg" aria-hidden="true">${esc(initials(p.name)||'?')}</span><div><label class="lbl" for="nm">השם שלך</label><input class="in" id="nm" data-bind="name" value="${esc(p.name)}" placeholder="שם מלא" autocomplete="name"></div></div></section>`;
  const rs=p.roles||[],rp=(a,b)=>`aria-pressed="${a}" data-action="role" data-role="${b}"`;
  h+=`<section class="card"><div class="card-h"><span class="ibadge" aria-hidden="true">${ico('shield')}</span><div><h2>התפקיד שלך</h2><p class="hint" style="margin:0">קובע באילו משמרות תשובץ</p></div></div><div class="seg" role="group" aria-label="התפקיד שלך"><button ${rp(rs.length===1&&rs[0]==='insp','insp')}>${ico('shield')}בודק CX</button><button ${rp(rs.length===1&&rs[0]==='load','load')}>${ico('bolt')}עומסים</button><button ${rp(rs.length===2,'both')}>${ico('layers')}שניהם</button></div><p class="hint" style="margin:12px 0 0">בבוקר ובערב כל משמרת כוללת בודקי CX ועומסים. בלילה עובד אחד אחראי על בדיקות ומצברים, ולכן הוא צריך להיות בודק CX.</p></section>`;
  const doneN=ds.filter(d=>dayDone(p,d.w)).length;
  h+=`<section class="card"><div class="card-h"><span class="ibadge" aria-hidden="true">${ico('calendar')}</span><div><h2>העדפות לשבוע</h2></div></div><p class="hint">לכל יום, לחץ על המשמרות לפי הסדר שאתה מעדיף. הראשונה שתבחר היא עדיפות 1, ואחרי שתיים השלישית נקבעת לבד.</p>
    <div class="prog" aria-hidden="true">${ds.map(d=>`<span class="${dayDone(p,d.w)?'done':''}"></span>`).join('')}</div><div class="progl num">הושלמו ${doneN} מתוך ${ds.length} ימים</div>`;
  ds.forEach(d=>{const dd=p.days[d.w]||{};const off=!!dd.off;const ord=Array.isArray(dd.order)?dd.order:[];const done=dayDone(p,d.w);const fri=d.w===FRI;
    h+=`<div class="dayblock"><div class="dayhead"><div class="dname">${DAYN[d.w]} <small class="num">${dm(d.date)}</small></div>
      <div class="dacts">${done?'<span class="dstat" aria-label="הושלם">✓</span>':''}<button class="btn-s" data-action="dayOff" data-day="${d.w}" aria-pressed="${off}">לא זמין</button></div></div>`;
    if(off)h+=`<p class="offtag">סימנת שאינך זמין ביום ${DAYN[d.w]}.</p>`;
    else{h+=tilesHTML(ord,d.w,true);
      const links=[];
      if(!fri&&ord.length===3&&ds.some(x=>x.w!==d.w&&x.w!==FRI))links.push(`<button class="link" data-action="copyDay" data-day="${d.w}">העתק לשאר הימים</button>`);
      if(!fri&&ord.length)links.push(`<button class="link" data-action="dayClear" data-day="${d.w}">איפוס</button>`);
      const note=fri?(ord.length?'אתה זמין לשישי בוקר':'לחץ אם אתה זמין לשישי בוקר'):(ord.length===3?'':`נבחרו ${ord.length} מתוך 3`);
      h+=`<div class="tiles-foot"><span>${note}</span><span style="display:flex;gap:14px">${links.join('')}</span></div>`}
    h+='</div>'});
  h+='</section>';
  h+=`<section class="card"><label class="lbl" for="nt">הערה למנהל <span style="color:var(--ink-3);font-weight:400">(לא חובה)</span></label><textarea class="in" id="nt" data-bind="note" placeholder="לדוגמה: מעדיף להיות נוכח בבדיקות בעומס, אשמח לבוקר">${esc(p.note)}</textarea></section>`;
  h+=`<div style="text-align:center"><button class="link" data-action="copyCode" ${complete(p)?'':'disabled'}>העתק קוד למנהל</button>${S.mode==='live'?'<div class="hint" style="margin:4px auto 0">רק אם השמירה נכשלת אצלך</div>':''}</div>`;
  h+=`<details class="restore"><summary class="link">שחזור בחירות מקוד</summary><p class="hint" style="margin-top:8px">אם הבחירות שלך נעלמו, הדבק כאן את הקוד ששלחת למנהל.</p><textarea class="in" id="rcode" style="direction:ltr" placeholder="CXE:…"></textarea><div class="btns" style="margin-top:8px"><button class="btn ghost" data-action="restoreCode">שחזר</button></div></details>`;
  return h}

function summaryHTML(p,ds){const when=new Date(S.savedAt).toLocaleString('he-IL',{weekday:'long',day:'numeric',month:'numeric',hour:'2-digit',minute:'2-digit'});
  const pub=S.schedule&&S.schedule.period===S.settings.start&&S.schedule.people&&S.schedule.people[myId()];
  return`<section class="card saved"><div class="savedhead"><span class="bigok" aria-hidden="true">✓</span><div><h2>ההעדפות של ${esc(p.name)} שמורות</h2><p class="hint" style="margin:2px 0 0">נשמר ${esc(when)}. אפשר לסגור ולחזור בכל זמן, הבחירות יחכו לך כאן.</p></div></div>
    <p class="hint" style="margin:0 0 10px">תפקיד: <b>${(p.roles||[]).length===2?'בודק CX ועומסים':esc(ROLEFULL[(p.roles||[])[0]]||'לא נבחר')}</b></p><div class="sumlist">${ds.map(d=>{const off=isOff(p,d.w);const o=dayOrder(p,d.w)||[];
      return`<div class="sumrow"><div class="dname">${DAYN[d.w]} <small class="num">${dm(d.date)}</small></div>${off?'<span class="offtag">לא זמין</span>':(d.w===FRI?`<div class="pills"><span class="pill ph-m"><i>✓</i>בוקר בלבד</span></div>`:pillsHTML(o,false))}</div>`}).join('')}</div>
    ${p.note?`<div class="sumnote"><b>הערה למנהל:</b> ${esc(p.note)}</div>`:''}
    <div class="btns" style="margin-top:16px"><button class="btn" data-action="editPrefs">עריכת הבחירות</button>${pub?'<button class="btn ghost" data-action="tab" data-tab="sched">למשמרות שלי</button>':''}<button class="btn ghost" data-action="copyCode">העתק קוד למנהל</button></div></section>`}


function fcHTML(p){return`<div class="fc">${periodDays(S.settings).map(d=>{const off=isOff(p,d.w);const o=dayOrder(p,d.w);const sh=!off&&o?o[0]:null;return`<span title="${DAYN[d.w]}: ${off?'לא זמין':sh?SHL[sh]:'לא מולא'}"><b class="${sh?SHC[sh]:''}"></b>${DAYS[d.w]}</span>`}).join('')}</div>`}

const sortByRole=(ids,rl)=>rl?ids.slice().sort((a,b)=>(ROLEORD[rl[a]]??3)-(ROLEORD[rl[b]]??3)):ids;
const myRole=(sc,k,id)=>((sc.roles||{})[k]||{})[id];
function chipHTML(id,name,r,opts={}){const me=id===myId();const tag=opts.btn?'button':'span';const role=opts.role;
  return`<${tag} class="chip ${me?'me':''} ${opts.sel?'sel':''} ${opts.warn?'warn':''}" ${opts.warn?`title="${esc(opts.warn)}"`:''} ${opts.btn?`data-action="chip" data-key="${opts.key}" data-id="${esc(id)}"`:''}><span class="av ${role?ROLEC[role]:''}" aria-hidden="true">${esc(initials(name))}</span><span class="cn">${opts.warn?'<span class="wi" aria-hidden="true">⚠</span> ':''}${esc(name)}</span>${role?`<span class="rt ${ROLEC[role]}">${ROLESHORT[role]}</span>`:''}${r!=null?`<span class="r r${r} num" title="${RANKW[r]}">${r+1}</span>`:''}</${tag}>`}

function gridHTML(sc,editable){
  const s=S.settings;const team=teamAll();
  const bad={};if(editable)restIssues(s,sc).forEach(i=>{const t=issueText(i,s);bad[i.prev.key+'|'+i.id]=t;bad[i.next.key+'|'+i.id]=t});
  let ds=periodDays(s);
  if(sc.period!==s.start){const keys=Object.keys(sc.days||{}).sort();ds=keys.map(k=>{const d=parseYmd(k);return{w:d.getDay(),date:d,key:k}})}
  return`<div class="grid">${ds.map(d=>{const o=sc.days[d.key]||{morning:[],afternoon:[],evening:[]};const rk=(sc.ranks||{})[d.key]||{};const rl=(sc.roles||{})[d.key]||null;
    const isToday=d.key===ymd(new Date());
    let h=`<div class="day ${isToday?'today':''}"><div class="day-h"><b>${DAYN[d.w]}</b><span class="dpill num">${isToday?'<span class="today-tag">היום</span>':''}${dm(d.date)}</span></div>`;
    dayShifts(d.w).forEach(sh=>{const ids=sortByRole(o[sh]||[],rl);const cap=capOf(s,d.w,sh);const miss=rl?missingRoles(s,d.w,sh,rl,ids):{};
      h+=`<div class="shift ${SHC[sh]}"><div class="shift-h"><span class="si">${ico(SHI[sh])}</span><b>${SHL[sh]}</b><span class="hh num">${hrsOf(s,d.w,sh)}</span><span class="cap num ${ids.length<cap?'short':''}">${ids.length}/${cap}</span></div><div class="chips">
        ${ids.map(id=>chipHTML(id,sc.people[id]||'?',(editable||id===myId())?rk[id]:null,{btn:editable,key:d.key,role:rl&&rl[id],warn:bad[d.key+'|'+id],sel:S.moving&&S.moving.key===d.key&&S.moving.id===id})).join('')||'<span class="empty-slot">אין שיבוץ</span>'}</div>${Object.keys(miss).length?`<div class="miss">חסר: ${Object.keys(miss).map(r=>ROLEFULL[r]+(miss[r]>1?' ×'+miss[r]:'')).join(', ')}</div>`:''}</div>`});
    if(editable){const assigned=new Set(SH.flatMap(sh=>o[sh]||[]));const ids=Object.keys(sc.people);
      const bench=ids.filter(id=>!assigned.has(id)&&team[id]&&!isOff(team[id],d.w));const off=ids.filter(id=>team[id]&&isOff(team[id],d.w));
      if(bench.length)h+=`<div class="bench">זמינים ולא משובצים<div class="chips">${bench.map(id=>chipHTML(id,sc.people[id],null,{btn:true,key:d.key,sel:S.moving&&S.moving.key===d.key&&S.moving.id===id})).join('')}</div></div>`;
      if(off.length)h+=`<div class="bench">לא זמינים: ${off.map(id=>esc(sc.people[id])).join(', ')}</div>`;}
    return h+'</div>'}).join('')}</div>`}

function statsHTML(sc){const {c,t}=schedStats(sc);if(!t)return'';const pct=x=>Math.round(x/t*100);const short=shortages(S.settings,sc);
  return`<div class="statgrid"><div><div class="bignum num">${pct(c[0])}%</div><small>קיבלו עדיפות 1</small></div><div><div class="bignum num">${pct(c[0]+c[1])}%</div><small>עדיפות 1 או 2</small></div><div><div class="bignum num" style="${short?'color:var(--danger)':''}">${short}</div><small>משבצות חסרות</small></div></div>
  <div class="dist" aria-hidden="true"><span style="width:${pct(c[0])}%;background:var(--ok)"></span><span style="width:${pct(c[1])}%;background:var(--mid)"></span><span style="width:${pct(c[2])}%;background:var(--warn)"></span></div>
  <div class="legend num"><span><i style="background:var(--ok)"></i>עדיפות 1: ${c[0]}</span><span><i style="background:var(--mid)"></i>עדיפות 2: ${c[1]}</span><span><i style="background:var(--warn)"></i>עדיפות 3: ${c[2]}</span></div>`}

function nextShiftInfo(sc,me){
  const st=S.settings,n=new Date(),todayU=Date.UTC(n.getFullYear(),n.getMonth(),n.getDate()),nowMin=todayU/60000+n.getHours()*60+n.getMinutes();
  let best=null;
  Object.keys(sc.days).sort().forEach(k=>{const w=parseYmd(k).getDay();dayShifts(w).forEach(sh=>{if((sc.days[k][sh]||[]).includes(me)){const sp=spanOf(st,k,w,sh);if(sp.b>nowMin&&(!best||sp.a<best.a))best={k,w,sh,a:sp.a,b:sp.b}}})});
  if(!best)return null;
  const [y,m,d]=best.k.split('-').map(Number),dd=Math.round((Date.UTC(y,m-1,d)-todayU)/864e5),live=best.a<=nowMin,diff=best.a-nowMin;
  let when;
  if(live)when='עכשיו';
  else if(dd===0)when=diff<60?`בעוד ${diff} דקות`:`היום, בעוד ${Math.round(diff/60)} שעות`;
  else if(dd===1)when='מחר';
  else when=`יום ${DAYN[best.w]} ${dm(parseYmd(best.k))}`;
  return{...best,when,live}}
function viewSched(){
  const s=S.settings,sc=S.schedule;
  if(!sc||!sc.days)return`<div class="card emptystate"><span class="mark" aria-hidden="true"><i></i><i></i><i></i></span><h3>הסידור עוד לא פורסם</h3><p class="hint" style="margin:0 auto 16px">כשהמנהל ישבץ ויפרסם, המשמרות שלך יופיעו כאן.${complete(S.me)&&S.savedAt?'':' בינתיים מלא את ההעדפות שלך.'}</p>${complete(S.me)&&S.savedAt?'':'<button class="btn" data-action="tab" data-tab="prefs">למילוי העדפות</button>'}</div>`;
  let h='';
  if(sc.period!==s.start)h+=`<div class="banner"><span>🗓️</span><span>זה הסידור של השבוע הקודם. הסידור החדש יפורסם אחרי סיום ההגשה.</span></div>`;
  const me=myId();
  if(sc.people&&sc.people[me]){
    const nx=nextShiftInfo(sc,me);
    if(nx){const rl=myRole(sc,nx.k,me);h+=`<section class="nextcard ${SHC[nx.sh]}"><span class="nx-ic">${ico(SHI[nx.sh])}</span><div><small>${nx.live?'המשמרת שלך מתבצעת עכשיו':'המשמרת הבאה שלך'}</small><b>${esc(nx.when)} · ${SHL[nx.sh]}</b><span class="m"><bdi class="ltr num">${hrsOf(s,nx.w,nx.sh)}</bdi>${rl?' · '+ROLEFULL[rl]:''}</span></div></section>`}
