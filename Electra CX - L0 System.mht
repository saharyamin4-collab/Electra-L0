      if(!snap.metadata.fromCache){ connected=true; clearTimeout(dbTimer); if(!$('sync').classList.contains('ok')) setSync('ok','מסונכרן'); }
      reports=snap.docs.map(x=>({...clone(x.data()),id:x.id}));
      if(!snap.metadata.fromCache&&cur&&!cur.id&&readDraft(null)&&!restoreNewDone){ restoreNewDone=true; const h=readSec('hdr');
        const dup=HREQ.every(f=>h[f])&&reports.find(r=>norm(r.site)===norm(h.site)&&norm(quad(r))===norm(h.quadrant)&&norm(r.module)===norm(h.module));
        if(dup){ dropDraft(null); showDraftBanner(''); newChecklist(null); } else { queueSave('hdr'); SECS.forEach(k=>queueSave(k)); } }
      if(!openedFromHash){ const m=(location.hash||'').match(/^#m-([A-Za-z0-9-]+)$/); if(m&&reports.find(r=>r.id===m[1])){ openedFromHash=true; openReport(m[1]); return; } }
      if(cur&&cur.id){ const remote=reports.find(r=>r.id===cur.id);
        if(remote){ const wasFinal=isFinal(cur);
          const keep={}; SECS.forEach(k=>{ if(dirty[k]||$('st'+k[1]).contains(document.activeElement)){ keep[k]={}; TEXT[k].forEach(f=>keep[k][f]=cur[k][f]); } });
          const keepH=(dirty.hdr||$('hdr').contains(document.activeElement))?Object.fromEntries(HDR.map(f=>[f,cur[f]])):null;
          cur=clone(remote); if(keepH&&!isFinal(cur)) Object.assign(cur,keepH); if(!isFinal(cur)) SECS.forEach(k=>{ if(keep[k]&&!cur[k].sig) Object.assign(cur[k],keep[k]); });
          paint(false); if(isFinal(cur)&&!wasFinal) verify();
          return; } }
      paintList();
      if(connected) runQueue();
    },err=>setSync('bad','שגיאת סנכרון: '+(err&&err.code||'')));
  });
})();
</script>
</body>
</html>
