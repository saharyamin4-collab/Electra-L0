    return p.then(()=>setSync('ok','נשמר '+new Date().toLocaleTimeString('he-IL',{timeStyle:'short'})), e=>{ setSync('bad','שמירה נכשלה, מנסה שוב'); throw e; });
  }
  async function writeRetry(id,patch,tries=5){ for(let i=0;i<tries;i++){ try{ await write(id,patch); return true; }catch(_){ await sleep(1000*2**i); } } setSync(navigator.onLine===false?'off':'bad',navigator.onLine===false?'אין חיבור, נשמר במכשיר':'לא נשמר בשרת, ננסה שוב'); toast('אין חיבור לשרת כרגע. השינויים שמורים במכשיר ויישלחו אוטומטית.'); return false; }
  async function snapshotVersion(reason){ try{ await col.doc(cur.id).collection('versions').doc('v'+Date.now()).set({reason,at:Date.now(),by:me,data:clone(cur)}); }catch(_){} }

  function readSec(sec){
    if(sec==='hdr'){ const o={}; HDR.forEach(k=>o[k]=$(k).value.trim()); return o; }
    const o={}; TEXT[sec].forEach(f=>{ const el=document.querySelector('#st'+sec[1]+' [data-f="'+f+'"]'); o[f]=el.type==='checkbox'?el.checked:el.value; }); return o;
  }
  function queueSave(sec){ if(!cur||isFinal(cur)) return; dirty[sec]=true; ver[sec]=(ver[sec]||0)+1; saveDraft(); if(cur.id) setSync(navigator.onLine===false?'off':'',navigator.onLine===false?'אין חיבור, נשמר במכשיר':'שומר…'); clearTimeout(timers[sec]); timers[sec]=setTimeout(()=>flush(sec),900); }
  let creating=null;
  async function ensureCreated(){
    if(cur.id) return true;
