  const TEXT={s1:['name','empId','tool','calib','notes','declared'],s2:['name','role','date','notes','declared'],s4:['name','role','date','notes','declared'],s3:['name','inspector','no','date','clean1','clean2','declared']};
  const HDR=['module','site','quadrant'], HREQ=['module','site','quadrant'];
  const quad=r=>(r.quadrant!=null&&r.quadrant!=='')?r.quadrant:(r.location||'');
  let db=null,col=null,assets=null,downloads=null,userNs=null,me='',canEdit=false;
  let reports=[],cur=null,connected=false,brand={},sealState=null;
  const dirty={},timers={},pads={},pending=new Map();

  const toast=m=>{const t=$('toast');t.textContent=m;t.classList.add('on');clearTimeout(toast.h);toast.h=setTimeout(()=>t.classList.remove('on'),3200);};
  const fmt=t=>t?new Date(t).toLocaleString('he-IL',{dateStyle:'short',timeStyle:'short'}):'';
  const src=p=>p&&(p.assetId?window.__assetURL(p.assetId):p.data);
  const clone=o=>JSON.parse(JSON.stringify(o));
