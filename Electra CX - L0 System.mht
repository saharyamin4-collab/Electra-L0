  const esc=s=>String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  const done=r=>SECS.filter(k=>r[k]&&r[k].sig).length;
  const isFinal=r=>!!(r&&r.final);
  const sleep=ms=>new Promise(r=>setTimeout(r,ms));

  function blank(){
    return {id:null,module:'',site:'',quadrant:'',createdAt:Date.now(),updatedAt:Date.now(),log:{},final:false,
      s1:{name:'',empId:'',tool:'',calib:'',notes:'',declared:false,sig:null,signedAt:0},
      s2:{name:'',role:'',date:'',notes:'',declared:false,photos:{},cells:{},scans:{},fixed:true,sig:null,signedAt:0},
      s4:{name:'',role:'',date:'',notes:'',declared:false,photos:{},sig:null,signedAt:0},
      s3:{name:'',inspector:'',no:'',date:'',clean1:false,clean2:false,declared:false,files:{},sig:null,signedAt:0}};
  }
  const cellsOf=r=>live((r.s2&&r.s2.cells)||{}).sort((a,b)=>((a.t||0)-(b.t||0))||String(a.id).localeCompare(String(b.id)));
  /* fixed inspection items: per UPS, 7 cells + the UPS body + the UPS ceiling (edit these 3 numbers to change the scheme) */
  const UPS_N=2, CELLS_N=7, ITEMS=[];
  for(let u=1;u<=UPS_N;u++){ for(let c=1;c<=CELLS_N;c++) ITEMS.push({id:'u'+u+'c'+c,label:'UPS '+u+' / תא '+c,grp:'UPS '+u}); ITEMS.push({id:'u'+u+'body',label:'UPS '+u+' / גוף ה־UPS',grp:'UPS '+u}); ITEMS.push({id:'u'+u+'ceil',label:'UPS '+u+' / תקרת UPS',grp:'UPS '+u}); }
  /* checklists whose stage 2 was already signed before this scheme keep the old free-form cells */
  const isFixed=r=>!!(r.s2&&r.s2.fixed)||(!(r.s2&&r.s2.sig)&&!isFinal(r));
  const scanOk=(r,id)=>!!(((r.s2&&r.s2.scans)||{})[id]||{}).ok;
  function s2Model(r){ const cells=cellsOf(r), ph=live(r.s2.photos), used=new Set();
    if(isFixed(r)){ const rows=ITEMS.map(it=>{ const ps=ph.filter(p=>p.cell===it.id), p=ps[ps.length-1]; if(p) used.add(p.assetId); return {c:{id:it.id},label:it.label,grp:it.grp,p,scan:scanOk(r,it.id)}; }); return {rows,extra:ph.filter(p=>!used.has(p.assetId)),fixed:true}; }
    const rows=cells.map((c,i)=>{ const ps=ph.filter(p=>p.cell===c.id), p=ps[ps.length-1]; if(p) used.add(p.assetId); return {c,label:'תא '+(i+1),p}; });
    return {rows,extra:ph.filter(p=>!used.has(p.assetId))}; }
  let lastCellT=0;
  const logEntry=text=>{const t=Date.now();return{['e'+t+Math.random().toString(36).slice(2,5)]:{t,text,by:me}};};

  /* ---------- hashing / seal ---------- */
  async function sha(buf){ const h=await crypto.subtle.digest('SHA-256',typeof buf==='string'?new TextEncoder().encode(buf):buf); return [...new Uint8Array(h)].map(b=>b.toString(16).padStart(2,'0')).join(''); }
